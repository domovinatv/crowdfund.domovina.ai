{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crowdfund-domovina-ai",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Vrh datoteke je lokalni dev (nul-ID baze). `CLOUDFLARE_ENV=staging` pri buildu bira Worker
  // na crowdfund-staging.domovina.ai, račun D.O.M. (S10, odluka 1000). Deploy samo `npm run deploy:staging`.
  "workers_dev": true,

  "assets": { "directory": "./dist", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crowdfund-dev",
      // Lokalni placeholder: baza na računu ne postoji, radi se samo --local.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  "env": {
    "staging": {
      "name": "crowdfund-domovina-ai-staging",
      "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",
      "workers_dev": false,
      "routes": [{ "pattern": "crowdfund-staging.domovina.ai", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crowdfund-staging",
          "database_id": "7299d4ae-9d1b-44fd-aebc-3023125f48d5",
          "migrations_dir": "migrations"
        }
      ],
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
    }
  }
}
