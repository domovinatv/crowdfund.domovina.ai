{
  "name": "crowdfund-domovina-ai",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "crowdfund.domovina.ai — P2P crowdfunding prototip, plaćanje kroz MPT",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && vitest run && astro build",
    "test": "vitest run",
    "types": "wrangler types",
    "db:gen-core": "node scripts/generiraj-core-sql.mjs",
    "db:migrate:local": "wrangler d1 migrations apply crowdfund-dev --local",
    "db:gen-seed": "node scripts/seed.mjs",
    "db:seed:local": "npm run db:migrate:local && wrangler d1 execute crowdfund-dev --local --file seed/demo.sql",
    "routes": "node scripts/provjera-ruta.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@domovina/campaign-core": "github:domovinatv/campaign-core#v0.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/astro": "^1.79.0",
    "astro": "^7.4.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
