---
// Uvod zahtjeva organizacije (ekrani 20 i 26): pet koraka s opisom, nastavak nacrta, vlastite organizacije.
// Fizičke osobe kao organizatori postoje samo kao oznaka „nije u fazi 1” (odluka 8).
import Base from "../../layouts/Base.astro";
import PhaseBadge from "../../components/PhaseBadge.astro";
import { GUMB, GUMB_RUB } from "../../components/organizacija/ucitavanje";
import { KORACI_ZAHTJEVA } from "../../lib/db/organizacija";
import { url } from "../../lib/rute";
import { ORGANIZACIJA, umetni } from "../sadrzaj/organizacija";
import type { PropsStranice } from "../tipovi";
import type { PodaciUvodaZahtjeva } from "./organisation.new.ucitaj";

type Props = PropsStranice<PodaciUvodaZahtjeva>;
const { lang, podaci } = Astro.props;
const O = ORGANIZACIJA[lang];
const T = O.carobnjak;
const kljuc = (k: (typeof KORACI_ZAHTJEVA)[number]) => `organisation.new.${k}` as const;
---
<Base lang={lang} title={T.naslov} noindex>
  <div class="mx-auto max-w-2xl">
    <h1 class="page-title text-ink">{T.naslov}</h1>
    <p class="mt-2 text-ink-soft">{T.uvod}</p>

    {
      podaci.nacrt && (
        <div role="status" class="mt-6 rounded-md bg-mist p-4">
          <p>{umetni(T.nacrtPostoji, { organizacija: podaci.nacrt.naziv })}</p>
          <a href={url(lang, kljuc(podaci.nacrt.korak))} class:list={[GUMB, "mt-3"]}>{T.nastaviNacrt}</a>
        </div>
      )
    }

    <ol class="mt-6 space-y-3">
      {
        KORACI_ZAHTJEVA.map((k, i) => (
          <li class="flex gap-3 rounded-md border border-line p-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-mist font-semibold text-ink" aria-hidden="true">{i + 1}</span>
            <span>
              <span class="block font-semibold text-ink">{T.koraci[k]}</span>
              <span class="block text-sm text-ink-soft">{T.opisiKoraka[k]}</span>
            </span>
          </li>
        ))
      }
    </ol>

    {!podaci.nacrt && <a href={url(lang, "organisation.new.details")} class:list={[GUMB, "mt-6"]}>{T.zapocni}</a>}

    <p class="mt-6 flex flex-wrap items-center gap-2 text-sm text-ink-muted">{T.fizickeOsobe} <PhaseBadge lang={lang} /></p>

    {
      podaci.organizacije.length > 0 && (
        <section class="mt-10" aria-labelledby="moje-org">
          <h2 id="moje-org" class="text-xl font-semibold text-ink">{T.mojeOrganizacije}</h2>
          <ul class="mt-3 divide-y divide-line rounded-md border border-line">
            {podaci.organizacije.map((o) => (
              <li class="flex flex-wrap items-center justify-between gap-2 p-4">
                <span>
                  <span class="block font-medium text-ink">{o.naziv}</span>
                  <span class="text-sm text-ink-muted">
                    {O.statusOrganizacije[o.status]} · {O.uloge[o.uloga as keyof typeof O.uloge] ?? o.uloga}
                  </span>
                </span>
                <a href={url(lang, o.uloga === "owner" ? "org.application" : "org.campaigns", { slug: o.slug })} class={GUMB_RUB}>
                  {o.uloga === "owner" ? T.otvoriZahtjev : O.nav.kampanje}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
