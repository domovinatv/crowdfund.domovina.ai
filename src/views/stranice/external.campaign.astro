---
// Vanjska kampanja /hr/vanjska/{id} (docs/07, tok 9, odluka 209): oznaka „na 4fundu”, naš opis odnosa,
// organizacija s oznakom verifikacije, gumb na njihov URL (nova kartica, `noopener nofollow`).
// Iznos ne prikazujemo (nemamo ga; vodi se na vanjskoj platformi), vanjska slika se ne učitava.
import Base from "../../layouts/Base.astro";
import TemaNaslovne from "../../components/katalog/TemaNaslovne.astro";
import { datum } from "../../components/katalog/oblik";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ExternalLink from "@lucide/astro/icons/external-link";
import BadgeCheck from "@lucide/astro/icons/badge-check";
import Building from "@lucide/astro/icons/building";
import Info from "@lucide/astro/icons/info";
import { temaKategorije } from "../../components/katalog/teme";
import { prevoditelj } from "../../i18n";
import { url } from "../../lib/rute";
import { VANJSKA, umetni } from "../sadrzaj/javni";
import type { PropsStranice } from "../tipovi";
import type { VanjskaKampanja } from "../../lib/db/profili";
type Props = PropsStranice<VanjskaKampanja>;
const { lang, podaci: v } = Astro.props;
const T = VANJSKA[lang];
const t = prevoditelj(lang);
const je4fund = v.platform === "4fund";
const ime = v.organizacija.displayName;
const kategorija = v.category ? (lang === "hr" ? v.category.nameHr : v.category.nameEn) : null;
const sigurno = /^https:\/\//i.test(v.url) ? v.url : null;
const profil = url(lang, "org", { slug: v.organizacija.slug });
---
<Base lang={lang} title={v.title} description={umetni(T.opis, { ime })}>
  <a href={profil} class="mb-3 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-action hover:underline">
    <ArrowLeft size={16} aria-hidden="true" />
    {umetni(T.natrag, { ime })}
  </a>
  <article class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="min-w-0 max-w-[70ch]">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="inline-flex items-center gap-1 rounded-sm bg-action/10 px-2 py-0.5 font-semibold text-action">
          <ExternalLink size={14} aria-hidden="true" />
          {je4fund ? t("external.on4fund") : t("external.onOther")}
        </span>
        {kategorija && <span class="rounded-sm bg-mist px-2 py-0.5 font-medium text-ink-soft">{kategorija}</span>}
      </div>
      <h1 class="page-title mt-3 break-words text-ink">{v.title}</h1>
      <p class="mt-3 flex min-w-0 items-center gap-1.5 text-ink-soft">
        <Building size={18} aria-hidden="true" class="shrink-0" />
        <span class="sr-only">{T.organizacija}:</span>
        <a href={profil} class="truncate font-semibold text-action underline underline-offset-2">{ime}</a>
        {
          v.organizacija.verified && (
            <span class="inline-flex shrink-0 text-success" title={t("card.verified")}>
              <BadgeCheck size={18} aria-hidden="true" />
              <span class="sr-only">({t("card.verified")})</span>
            </span>
          )
        }
      </p>
      <p class="mt-4 text-ink-soft">{umetni(je4fund ? T.tekst4fund : T.tekstOstalo, { ime })}</p>
      {v.verifiedAt !== null && <p class="mt-3 text-sm text-ink-muted">{umetni(T.potvrdeno, { datum: datum(lang, v.verifiedAt) })}</p>}
    </div>

    <aside class="flex min-w-0 flex-col overflow-hidden rounded-md shadow-card">
      <TemaNaslovne tema={temaKategorije(v.categoryKey)} kategorija={v.categoryKey} class="h-28" />
      <div class="flex flex-col gap-3 p-4">
        <p class="flex gap-2 text-sm text-ink-soft">
          <Info size={18} aria-hidden="true" class="mt-0.5 shrink-0" />
          {T.iznos}
        </p>
        {
          sigurno && (
            <a
              href={sigurno}
              target="_blank"
              rel="noopener nofollow"
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-action px-5 font-semibold text-paper hover:bg-action-strong"
            >
              {je4fund ? T.gumb4fund : T.gumbOstalo}
              <ExternalLink size={18} aria-hidden="true" />
              <span class="sr-only">({T.novaKartica})</span>
            </a>
          )
        }
      </div>
    </aside>
  </article>
</Base>
