---
// Stranica ponude ili aukcije (faza 2, S8-B): opis, podaci, iznos, licitacije (bez imena) i onemogućena kupnja ili
// licitacija s objašnjenjem (fiskalizacija, DAC7). Izravan doprinos kampanji ostaje dostupan.
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import Gavel from "@lucide/astro/icons/gavel";
import ShoppingBag from "@lucide/astro/icons/shopping-bag";
import Base from "../../layouts/Base.astro";
import PhaseBadge from "../../components/PhaseBadge.astro";
import { formatDatuma, formatNovca } from "../../components/kampanja/format";
import { url } from "../../lib/rute";
import { FAZA2 } from "../sadrzaj/faza2";
import type { PodaciPonude } from "./offer.ucitaj";
import type { PropsStranice } from "../tipovi";

type Props = PropsStranice<PodaciPonude>;
const { lang, podaci: p } = Astro.props;
const T = FAZA2[lang].ponude;
const D = T.detalj;
const novac = formatNovca(lang, p.campaign.currency);
const aukcija = p.mode === "auction";
const iznos = aukcija && p.topBidCents !== null ? p.topBidCents : p.priceCents;
const oznakaIznosa = aukcija ? (p.topBidCents !== null ? T.najvisa : T.pocetna) : T.najmanje;
const podaciPonude: [string, string][] = [
  [D.vrsta, T.nacini[p.mode] ?? p.mode],
  ...(p.category ? ([[D.kategorija, T.kategorije[p.category] ?? p.category]] as [string, string][]) : []),
  ...(p.condition ? ([[D.stanje, T.stanja[p.condition] ?? p.condition]] as [string, string][]) : []),
  [D.dostava, T.dostave[p.delivery] ?? p.delivery],
  [D.kolicina, String(p.quantity)],
  ...(p.endsAt !== null ? ([[D.rok, formatDatuma(lang, p.endsAt)]] as [string, string][]) : []),
];
---
<Base lang={lang} title={p.title} description={(p.description ?? p.title).slice(0, 160)}>
  <a href={url(lang, "offers")} class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-action underline-offset-2 hover:underline">
    <ArrowLeft size={16} aria-hidden="true" />{D.natrag}
  </a>
  <div class="mt-4 lg:grid lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-10">
    <div class="min-w-0">
      <p class="flex flex-wrap items-center gap-2 text-sm text-ink-muted">
        {p.category && <span class="rounded-sm bg-mist px-2 py-0.5 font-medium text-ink-soft">{T.kategorije[p.category]}</span>}
        <span class="inline-flex items-center gap-1">
          {aukcija ? <Gavel size={16} aria-hidden="true" /> : <ShoppingBag size={16} aria-hidden="true" />}{T.nacini[p.mode]}
        </span>
        {p.status !== "active" && <span class="rounded-sm bg-mist px-2 py-0.5 font-semibold text-ink-soft">{T.statusi[p.status]}</span>}
        <PhaseBadge lang={lang} />
      </p>
      <h1 class="page-title mt-2 break-words text-ink">{p.title}</h1>
      <p class="mt-2 text-ink-soft">
        {T.zaKampanju}: <a href={url(lang, "campaign", { id: p.campaign.publicId })} class="font-semibold text-ink underline-offset-2 hover:underline">{p.campaign.title}</a>
        <span class="block text-sm text-ink-muted">{D.organizator}: {p.campaign.organizerName}</span>
      </p>
      {p.founder && <p class="mt-3 rounded-md bg-mist p-3 text-sm text-ink-soft"><strong class="text-action">{T.founder}.</strong> {T.founderOpis}</p>}

      <section aria-labelledby="opis-ponude" class="mt-8">
        <h2 id="opis-ponude" class="text-2xl font-semibold text-ink">{D.opis}</h2>
        <p class="mt-3 max-w-[70ch] whitespace-pre-line break-words text-ink-soft">{p.description}</p>
      </section>

      <section aria-labelledby="podaci-ponude" class="mt-8">
        <h2 id="podaci-ponude" class="text-2xl font-semibold text-ink">{D.podaci}</h2>
        <dl class="mt-3 grid max-w-[40rem] grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
          {podaciPonude.map(([k, v]) => (<><dt class="text-ink-muted">{k}</dt><dd class="font-medium text-ink">{v}</dd></>))}
        </dl>
      </section>

      {aukcija && (
        <section aria-labelledby="licitacije" class="mt-8">
          <h2 id="licitacije" class="text-2xl font-semibold text-ink">{D.licitacije}</h2>
          <p class="mt-1 text-sm text-ink-muted">{D.licitantiNapomena}</p>
          {p.licitacije.length === 0 ? (
            <p class="mt-3 text-ink-muted">{D.bezLicitacija}</p>
          ) : (
            <ol class="mt-3 max-w-[40rem] divide-y divide-line rounded-md bg-paper shadow-card">
              {p.licitacije.map((b) => (
                <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm">
                  <span class="font-medium text-ink">{D.licitant(b.licitant)}</span>
                  <span class="text-ink-muted">{formatDatuma(lang, b.createdAt)}</span>
                  <strong class="text-ink tabular-nums">{novac(b.amountCents)}</strong>
                </li>
              ))}
            </ol>
          )}
        </section>
      )}
    </div>

    <aside class="mt-8 lg:mt-0" aria-labelledby="iznos-ponude">
      <div class="rounded-md bg-paper p-5 shadow-card lg:sticky lg:top-4">
        <p id="iznos-ponude" class="text-sm text-ink-muted">{oznakaIznosa}</p>
        <p class="mt-1 text-3xl font-semibold text-ink tabular-nums">{novac(iznos)}</p>
        {aukcija && <p class="mt-1 text-sm text-ink-muted">{T.licitacija(p.bids)}</p>}
        {!aukcija && p.quantity > 1 && <p class="mt-1 text-sm text-ink-muted">{T.dostupno(p.quantity)}</p>}
        <button type="button" disabled aria-describedby="ponuda-onemogucena"
          class="mt-4 inline-flex min-h-11 w-full cursor-not-allowed items-center justify-center rounded-md bg-mist px-5 font-semibold text-ink-muted ring-1 ring-ink-muted/25">
          {aukcija ? T.licitiraj : T.kupi}
        </button>
        <p id="ponuda-onemogucena" class="mt-3 text-sm text-ink-soft">{T.onemoguceno}</p>
        <a href={url(lang, "campaign.support", { id: p.campaign.publicId })}
          class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-md bg-action px-5 font-semibold text-paper hover:bg-action-strong">
          {T.podrziIzravno}
        </a>
      </div>
    </aside>
  </div>
</Base>
