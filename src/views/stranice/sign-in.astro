---
// Prijava bez lozinke (ekran 25, docs/04 §1): e-pošta → kod; nepoznata e-pošta nudi račun (uvjeti);
// mock Google i registracija kao alternative. Radi bez JS-a.
import LogIn from "@lucide/astro/icons/log-in";
import Mail from "@lucide/astro/icons/mail";
import Greska from "../../components/prijava/Greska.astro";
import OkvirPrijave from "../../components/prijava/OkvirPrijave.astro";
import { upitNext } from "../../components/prijava/ucitavanje";
import { url } from "../../lib/rute";
import { PRIJAVA } from "../sadrzaj/prijava";
import type { PodaciPrijave } from "./sign-in.ucitaj";
import type { PropsStranice } from "../tipovi";

type Props = PropsStranice<PodaciPrijave>;
const { lang, podaci } = Astro.props;
const { email, next, greska, nepoznata, korisnik } = podaci;
const T = PRIJAVA[lang];
const P = T.prijava;
const poljeGreska = greska === "email_prazno" || greska === "email_neispravan" || greska === "obrisan" ? T.greske[greska] : null;
const polje = "mt-1.5 block w-full rounded-sm border bg-paper px-3 py-2.5 text-base text-ink placeholder:text-ink-muted";
const q = upitNext(next);
const registracija = url(lang, "sign-up") + (email ? `?email=${encodeURIComponent(email)}${next ? `&next=${encodeURIComponent(next)}` : ""}` : q);
---
<OkvirPrijave lang={lang} naslov={P.naslov} uvod={P.uvod}>
  {
    korisnik && (
      <p role="status" class="mt-4 rounded-md bg-mist p-4 text-sm">
        {P.vecPrijavljen.replace("{email}", korisnik.email)}{" "}
        <a href={next || url(lang, "home")} class="font-medium text-action underline underline-offset-2">{P.nastavi}</a>
      </p>
    )
  }
  {greska === "uvjeti" && <Greska poruka={T.greske.uvjeti} />}

  <form method="post" action={url(lang, "sign-in") + q} class="mt-6 space-y-5" novalidate>
    <input type="hidden" name="next" value={next} />
    <div>
      <label for="email" class="font-semibold text-ink">{P.eposta}</label>
      <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" value={email}
        aria-invalid={poljeGreska ? "true" : undefined} aria-describedby={poljeGreska ? "email-pomoc email-greska" : "email-pomoc"}
        class:list={[polje, poljeGreska ? "border-danger ring-1 ring-danger" : "border-ink-muted/60"]} />
      <p id="email-pomoc" class="mt-1.5 text-sm text-ink-muted">{P.epostaPomoc}</p>
      {poljeGreska && <p id="email-greska" class="mt-1 text-sm font-medium text-danger">{poljeGreska}</p>}
    </div>

    {
      nepoznata && (
        <fieldset class="rounded-md border border-line p-4">
          <legend class="px-1 font-semibold text-ink">{P.nepoznataNaslov}</legend>
          <input type="hidden" name="nepoznata" value="1" />
          <p class="text-sm text-ink-soft">{P.nepoznataTekst}</p>
          <label class="mt-3 flex items-start gap-3">
            <input type="checkbox" name="uvjeti" value="1" required class="mt-1 size-5 shrink-0 accent-action" />
            <span>
              {P.uvjetiPrije} <a href={url(lang, "terms")} class="text-action underline underline-offset-2">{P.uvjeti}</a> {P.uvjetiI}{" "}
              <a href={url(lang, "privacy")} class="text-action underline underline-offset-2">{P.privatnost}</a>
            </span>
          </label>
          <p class="mt-3 text-sm">
            {P.registracijaPitanje} <a href={registracija} class="font-medium text-action underline underline-offset-2">{P.registracija}</a>
          </p>
        </fieldset>
      )
    }

    <button type="submit" class="inline-flex min-h-11 items-center gap-2 rounded-md bg-action px-5 font-semibold text-paper hover:bg-action-strong">
      <Mail size={18} aria-hidden="true" />{nepoznata ? P.stvoriRacun : P.posalji}
    </button>
  </form>

  <p class="mt-8 flex items-center gap-3 text-sm text-ink-muted" aria-hidden="true"><span class="h-px flex-1 bg-line"></span>{P.ili}<span class="h-px flex-1 bg-line"></span></p>
  <div class="mt-4 flex flex-col gap-3">
    <a href={`/auth/google${q}`} class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md border border-ink-muted/60 px-4 font-medium text-ink hover:bg-mist">
      <LogIn size={18} aria-hidden="true" />{P.google}
    </a>
    <p class="text-center text-sm">
      <a href={url(lang, "sign-up") + q} class="font-medium text-action underline underline-offset-2">{P.registracija}</a>
    </p>
  </div>
</OkvirPrijave>
