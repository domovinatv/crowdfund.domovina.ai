---
// Pitanja jedne kategorije; svako pitanje je odjeljak s `h2` i sidrom (`#id`).
import StaticnaStranica from "../../components/StaticnaStranica.astro";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import { url } from "../../lib/rute";
import { FAQ, FAQ_STRANICA, KATEGORIJE_FAQ, type KategorijaFaq } from "../sadrzaj/faq";
import type { SadrzajStranice } from "../sadrzaj/tipovi";
import type { PropsStranice } from "../tipovi";
type Props = PropsStranice<{ kategorija: KategorijaFaq }>;
const { lang, podaci } = Astro.props;
const kat = FAQ[lang][podaci.kategorija];
const sadrzaj: SadrzajStranice = { naslov: kat.naziv, uvod: kat.opis, opis: `${FAQ_STRANICA[lang].naslov}: ${kat.naziv}. ${kat.opis}`, odjeljci: kat.pitanja };
const T = { hr: { natrag: "Sva česta pitanja", ostale: "Ostale teme" }, en: { natrag: "All FAQ topics", ostale: "Other topics" } }[lang];
---
<StaticnaStranica lang={lang} sadrzaj={sadrzaj} skupina="pomoc" aktivna="faq" naslovDokumenta={`${kat.naziv} · ${FAQ_STRANICA[lang].naslov}`}>
  <a slot="iznad" href={url(lang, "faq")} class="mb-3 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-action hover:underline">
    <ArrowLeft size={16} aria-hidden="true" />
    {T.natrag}
  </a>
  <nav aria-labelledby="ostale-teme" class="mt-12 max-w-[70ch] border-t border-line pt-6">
    <h2 id="ostale-teme" class="text-lg font-semibold text-ink">{T.ostale}</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        KATEGORIJE_FAQ.filter((k) => k !== podaci.kategorija).map((k) => (
          <li>
            <a href={url(lang, "faq.category", { category: k })} class="inline-flex min-h-11 items-center rounded-md px-4 text-sm font-semibold text-action ring-1 ring-action/30 hover:bg-action/10">
              {FAQ[lang][k].naziv}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</StaticnaStranica>
