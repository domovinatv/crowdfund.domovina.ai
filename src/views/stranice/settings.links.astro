---
// Linkovi za praćenje (ekran 16): moji linkovi sa statistikom, novi link, uključi / isključi. Bez JS-a.
import Plus from "@lucide/astro/icons/plus";
import Share2 from "@lucide/astro/icons/share-2";
import { broj, iznos } from "../../components/katalog/oblik";
import OkvirPostavki from "../../components/postavke/OkvirPostavki.astro";
import Polje from "../../components/postavke/Polje.astro";
import { url } from "../../lib/rute";
import { POSTAVKE } from "../sadrzaj/postavke";
import type { PropsStranice } from "../tipovi";
import type { PodaciLinkova } from "./settings.links.ucitaj";

type Props = PropsStranice<PodaciLinkova>;
const { lang, podaci } = Astro.props;
const { linkovi, vrijednosti: v, greske, ok } = podaci;
const T = POSTAVKE[lang];
const P = T.linkovi;
const g = (k: string) => (greske[k] ? T.greske[greske[k] as keyof typeof T.greske] ?? T.greske.neispravno : null);
const S = P.stupci;
---
<OkvirPostavki lang={lang} aktivna="settings.links" naslov={P.naslov} uvod={P.uvod}
  uspjeh={ok === "stvoren" ? P.stvoren : ok ? T.spremljeno : null} greska={Object.keys(greske).length ? T.greskaObrasca : null}>
  <p class="mt-3 text-sm">
    <a href={url(lang, "settings.links.sharing")} class="inline-flex items-center gap-1 font-medium text-action underline underline-offset-2">
      <Share2 size={14} aria-hidden="true" />{P.dijeljenja}
    </a>
  </p>
  {
    linkovi.length === 0 ? (
      <p class="mt-6 text-ink-muted">{P.prazno}</p>
    ) : (
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-line text-ink-muted">
            <tr>
              <th scope="col" class="py-2 pr-4 font-semibold">{S.link}</th>
              <th scope="col" class="py-2 pr-4 font-semibold">{S.kampanja}</th>
              <th scope="col" class="py-2 pr-4 text-right font-semibold">{S.posjeti}</th>
              <th scope="col" class="py-2 pr-4 text-right font-semibold">{S.doprinosa}</th>
              <th scope="col" class="py-2 pr-4 text-right font-semibold">{S.iznos}</th>
              <th scope="col" class="py-2 font-semibold">{S.stanje}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              linkovi.map((l) => (
                <tr>
                  <td class="py-3 pr-4">
                    <a href={`/z/${l.slug}`} class="font-mono text-action underline underline-offset-2">/z/{l.slug}</a>
                    {l.label && <span class="block text-ink-muted">{l.label}</span>}
                  </td>
                  <td class="py-3 pr-4"><a href={url(lang, "campaign", { id: l.publicId })} class="underline underline-offset-2">{l.naslov}</a></td>
                  <td class="py-3 pr-4 text-right">{broj(lang, l.posjeti)}</td>
                  <td class="py-3 pr-4 text-right">{broj(lang, l.doprinosa)}</td>
                  <td class="py-3 pr-4 text-right whitespace-nowrap">{iznos(lang, l.iznosCenti)}</td>
                  <td class="py-3">
                    <form method="post" action={url(lang, "settings.links")} class="flex flex-wrap items-center gap-2">
                      <span class:list={[l.status === "active" ? "text-success" : "text-ink-muted"]}>{l.status === "active" ? P.aktivan : P.iskljucen}</span>
                      <input type="hidden" name="id" value={l.id} />
                      <input type="hidden" name="akcija" value={l.status === "active" ? "iskljuci" : "ukljuci"} />
                      <button type="submit" class="inline-flex min-h-11 items-center rounded-md border border-ink-muted/60 px-3 font-medium text-ink hover:bg-mist">
                        {l.status === "active" ? P.iskljuci : P.ukljuci}
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    )
  }
  <section aria-labelledby="novi" class="mt-10 max-w-xl">
    <h2 id="novi" class="text-lg font-semibold text-ink">{P.novi}</h2>
    <form method="post" action={url(lang, "settings.links")} class="mt-4 space-y-5" novalidate>
      <input type="hidden" name="akcija" value="stvori" />
      <Polje ime="campaign" oznaka={P.kampanja} vrijednost={v.campaign} greska={g("campaign")} pomoc={P.kampanjaPomoc} max={6} obavezno />
      <Polje ime="slug" oznaka={P.slug} vrijednost={v.slug} greska={g("slug")} pomoc={P.slugPomoc} max={60} obavezno />
      <Polje ime="label" oznaka={P.oznaka} vrijednost={v.label} greska={g("label")} max={100} />
      <button type="submit" class="inline-flex min-h-11 items-center gap-2 rounded-md bg-action px-5 font-semibold text-paper hover:bg-action-strong">
        <Plus size={18} aria-hidden="true" />{P.stvori}
      </button>
    </form>
  </section>
</OkvirPostavki>
