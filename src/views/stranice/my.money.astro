---
// Kamo ide novac /hr/moje/novac (P, obilazak 09, odluka 6): nema isplate. Po organizaciji: Safe, mreža, prag
// potpisa, 0 potpisnika platforme, explorer i kampanje koje uplaćuju na taj Safe. Adrese su mock do S7.
import ExternalLink from "@lucide/astro/icons/external-link";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import OkvirMoje from "../../components/moje/OkvirMoje.astro";
import PhaseBadge from "../../components/PhaseBadge.astro";
import { formatNovca, skratiAdresu } from "../../components/kampanja/format";
import { MOJE } from "../sadrzaj/moje";
import type { PropsStranice } from "../tipovi";
import type { PodaciMogNovca } from "./my.money.ucitaj";

type Props = PropsStranice<PodaciMogNovca>;
const { lang, podaci } = Astro.props;
const M = MOJE[lang];
const T = M.novac;
const novac = formatNovca(lang);
---
<OkvirMoje lang={lang} aktivna="my.money" naslov={T.naslov} uvod={T.uvod}>
  {
    podaci.skupine.length === 0 ? (
      <p class="mt-6 rounded-md bg-mist px-4 py-6 text-sm text-ink-muted">{T.nema}</p>
    ) : (
      podaci.skupine.map((g) => (
        <section class="mt-8" aria-label={g.organizacija?.naziv ?? T.osobni}>
          <h2 class="flex flex-wrap items-center gap-2 text-xl font-semibold text-ink">
            <ShieldCheck size={20} aria-hidden="true" class="text-action" />
            {g.organizacija?.osobna ? <>{T.osobni}<PhaseBadge lang={lang} /></> : (g.organizacija?.naziv ?? T.osobni)}
          </h2>
          <p class="mt-1 text-sm text-ink-soft">{T.ukupno}: <span class="font-semibold text-ink tabular-nums">{novac(g.ukupnoCenti)}</span></p>
          <ul class="mt-3 grid gap-3">
            {g.kampanje.map((n) => {
              const d = g.detalji[n.kampanja.publicId];
              return (
                <li class="rounded-md bg-mist p-4">
                  <p class="font-semibold break-words text-ink">{n.kampanja.naslov} <span class="text-sm font-normal text-ink-muted">· {M.stanje[n.kampanja.stanje]}</span></p>
                  {n.safe ? (
                    <>
                      <dl class="mt-2 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm">
                        <dt class="text-ink-muted">{T.safe}</dt>
                        <dd class="font-mono text-ink" title={n.safe}>{skratiAdresu(n.safe)}</dd>
                        <dt class="text-ink-muted">{T.mreza}</dt>
                        <dd class="text-ink">{n.imeLanca ?? n.lanac}</dd>
                        {n.potpisi !== null && n.potpisi > 0 && (<><dt class="text-ink-muted">{T.potpisi}</dt><dd class="text-ink tabular-nums">{n.potpisi}</dd></>)}
                        <dt class="text-ink-muted">{T.platforma}</dt>
                        <dd class="font-semibold text-success tabular-nums">0</dd>
                        <dt class="text-ink-muted">{T.prikupljeno}</dt>
                        <dd class="text-ink tabular-nums">{novac(n.kampanja.prikupljenoCenti)}</dd>
                      </dl>
                      <p class:list={["mt-2 text-sm", n.provjeren ? "text-success" : "text-warning"]}>{n.provjeren ? T.provjeren : T.neprovjeren}</p>
                    </>
                  ) : (
                    <p class="mt-2 text-sm text-warning">{T.nemaSafe}</p>
                  )}
                  <p class="mt-2 flex flex-wrap gap-x-4">
                    {n.explorer && (
                      <a href={n.explorer} rel="noopener noreferrer" target="_blank" class="inline-flex min-h-11 items-center gap-1 text-sm font-medium text-action underline underline-offset-2">
                        {T.explorer}<ExternalLink size={14} aria-hidden="true" />
                      </a>
                    )}
                    {d && <a href={d.href} class="inline-flex min-h-11 items-center text-sm font-medium text-action underline underline-offset-2">{T.detalji}</a>}
                  </p>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    )
  }
</OkvirMoje>
