---
// Čarobnjak, korak 3 (ekran 05): tema naslovnice (15, naše ilustracije kao gradijent, odluka 216), video
// poveznica; prijenos fotografija je jasno označen mock (nema R2 u prototipu).
import ImageUp from "@lucide/astro/icons/image-up";
import OkvirCarobnjaka from "../../components/carobnjak/OkvirCarobnjaka.astro";
import { POLJE, porukaPolja, rubPolja } from "../../components/carobnjak/poruke";
import TemaNaslovne from "../../components/katalog/TemaNaslovne.astro";
import { TEMA_KATEGORIJE, TEME } from "../../lib/db/nacrti";
import { url } from "../../lib/rute";
import { CAROBNJAK } from "../sadrzaj/carobnjak";
import { TEME_NASLOVNICE } from "../sadrzaj/kampanja";
import type { PodaciKoraka } from "../../components/carobnjak/ucitavanje";
import type { PropsStranice } from "../tipovi";

type Props = PropsStranice<PodaciKoraka>;
const { lang, podaci } = Astro.props;
const T = CAROBNJAK[lang];
const M = T.mediji;
const { nacrt, greske, polja } = podaci;
const tema = polja?.tema ?? nacrt.tema ?? TEMA_KATEGORIJE[nacrt.kategorija ?? ""] ?? "general";
const video = polja?.video ?? nacrt.videoUrl ?? "";
const g = { tema: porukaPolja(lang, greske, "tema"), video: porukaPolja(lang, greske, "video") };
const imena = TEME_NASLOVNICE[lang];
---
<OkvirCarobnjaka lang={lang} podaci={podaci} naslov={M.naslov}>
  <form method="post" action={url(lang, "new-campaign.media")} class="mt-6 space-y-8" novalidate>
    <section aria-labelledby="slike" class="rounded-md border-2 border-dashed border-warning/60 bg-warning-bg p-4">
      <h2 id="slike" class="flex items-center gap-2 font-semibold text-ink"><ImageUp size={18} aria-hidden="true" />{M.slike}</h2>
      <p class="mt-1 text-sm text-ink-soft">{M.slikePomoc}</p>
      <label class="mt-3 block text-sm text-ink-muted">
        <span class="sr-only">{M.slike}</span>
        <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple disabled class="block w-full text-sm" />
      </label>
      <p class="mt-2 text-sm font-medium text-warning" data-mock="upload">{M.slikeMock}</p>
    </section>

    <fieldset aria-describedby={g.tema ? "tema-pomoc tema-greska" : "tema-pomoc"}>
      <legend class="text-lg font-semibold text-ink">{M.tema}</legend>
      <p id="tema-pomoc" class="text-sm text-ink-muted">{M.temaPomoc}</p>
      <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          TEME.map((t) => (
            <label class="cursor-pointer overflow-hidden rounded-md border border-ink-muted/40 has-[:checked]:border-action has-[:checked]:ring-2 has-[:checked]:ring-action">
              <TemaNaslovne tema={t} kategorija={nacrt.kategorija ?? null} class="aspect-video" />
              <span class="flex min-h-11 items-center gap-2 px-3 py-2">
                <input type="radio" name="tema" value={t} checked={tema === t} class="size-5 shrink-0 accent-action" />
                <span class="text-sm text-ink">{imena[t] ?? t}</span>
              </span>
            </label>
          ))
        }
      </div>
      {g.tema && <p id="tema-greska" class="mt-2 text-sm font-medium text-danger">{g.tema}</p>}
    </fieldset>

    <div>
      <label for="video" class="font-semibold text-ink">{M.video}</label>
      <input id="video" name="video" type="url" inputmode="url" maxlength="500" value={video} placeholder="https://"
        aria-invalid={g.video ? "true" : undefined} aria-describedby={g.video ? "video-pomoc video-greska" : "video-pomoc"}
        class:list={[POLJE, rubPolja(g.video)]} />
      <p id="video-pomoc" class="mt-1.5 text-sm text-ink-muted">{M.videoPomoc}</p>
      {g.video && <p id="video-greska" class="mt-1 text-sm font-medium text-danger">{g.video}</p>}
    </div>

    <details class="rounded-md bg-mist p-4">
      <summary class="cursor-pointer font-semibold text-ink">{M.savjetiNaslov}</summary>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-ink-soft">
        {M.savjeti.map((s) => <li>{s}</li>)}
      </ul>
    </details>

    <div class="flex flex-wrap justify-between gap-3">
      <a href={url(lang, "new-campaign.goal")} class="inline-flex min-h-11 items-center rounded-md border border-ink-muted/60 px-4 font-medium text-ink hover:bg-mist">{T.natrag}</a>
      <button type="submit" class="inline-flex min-h-11 items-center rounded-md bg-action px-5 font-semibold text-paper hover:bg-action-strong">{T.dalje}</button>
    </div>
  </form>
</OkvirCarobnjaka>
