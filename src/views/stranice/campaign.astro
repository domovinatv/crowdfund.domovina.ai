---
// Stranica kampanje (ekran 22, docs/08 §5.1): galerija, zaglavlje, brojke, sidra sekcija, opis i „Kamo ide
// novac”, novosti, kasice, uplate, komentari, ponude, dijeljenje i promocija, praćenje, prijava sadržaja.
// Mobitel: ljepljiva donja traka; lg+: dva stupca s ljepljivim panelom desno.
import Flag from "@lucide/astro/icons/flag";
import LockKeyhole from "@lucide/astro/icons/lock-keyhole";
import Plus from "@lucide/astro/icons/plus";
import PiggyBank from "@lucide/astro/icons/piggy-bank";
import Settings from "@lucide/astro/icons/settings";
import Base from "../../layouts/Base.astro";
import PhaseBadge from "../../components/PhaseBadge.astro";
import CampaignHeader from "../../components/kampanja/CampaignHeader.astro";
import CampaignStats from "../../components/kampanja/CampaignStats.astro";
import CampaignTabs, { type SidroSekcije } from "../../components/kampanja/CampaignTabs.astro";
import CommentThread from "../../components/kampanja/CommentThread.astro";
import ContributorList from "../../components/kampanja/ContributorList.astro";
import FollowButton from "../../components/kampanja/FollowButton.astro";
import Galerija from "../../components/kampanja/Galerija.astro";
import MoneyboxCard from "../../components/kampanja/MoneyboxCard.astro";
import MoneyDestination from "../../components/kampanja/MoneyDestination.astro";
import PausedNotice from "../../components/kampanja/PausedNotice.astro";
import PromoTools from "../../components/kampanja/PromoTools.astro";
import ShareSheet from "../../components/kampanja/ShareSheet.astro";
import SupportBar from "../../components/kampanja/SupportBar.astro";
import UpdateList from "../../components/kampanja/UpdateList.astro";
import KarticaPonude from "../../components/ponude/KarticaPonude.astro";
import { formatDatuma, formatNovca } from "../../components/kampanja/format";
import { KLASA_OPISA, obicniTekstOpisa, renderirajOpis } from "../../lib/opis";
import { url } from "../../lib/rute";
import { FAZA2 } from "../sadrzaj/faza2";
import { KAMPANJA } from "../sadrzaj/kampanja";
import { UPRAVLJANJE } from "../sadrzaj/upravljanje";
import type { PodaciKampanje } from "./campaign.ucitaj";
import type { PropsStranice } from "../tipovi";

type Props = PropsStranice<PodaciKampanje>;
const { lang, podaci } = Astro.props;
const { k, novosti, kasice, uplate, stranicaUplata, josUplata, komentari, ponude, novostiRazina, adresa, pracenje, komentiranje, upravljanje } = podaci;
const T = KAMPANJA[lang];
const F = FAZA2[lang];
/** Sekcija ponuda: kad kampanja prima ponude (i prazna, s „Dodaj ponudu”) ili kad ih ima (faza 2). */
const sekcijaPonuda = k.postavke.ponudeDopustene || ponude.length > 0;
const J = UPRAVLJANJE[lang].javno;
const put = url(lang, "campaign", { id: k.publicId });
const novac = formatNovca(lang, k.currency);
const prijava = `${url(lang, "sign-in")}?next=${encodeURIComponent(`${put}#komentari`)}`;
const prijaviKampanju = `${url(lang, "report")}?target=campaign&id=${k.publicId}`;

const sidra: SidroSekcije[] = [
  { id: "novosti", kljuc: "novosti", broj: k.brojevi.novosti },
  { id: "opis", kljuc: "opis", broj: null },
];
if (k.razine.length > 0) sidra.push({ id: "razine", kljuc: "razine", broj: k.razine.length });
if (k.postavke.kasiceDopustene) sidra.push({ id: "kasice", kljuc: "kasice", broj: k.brojevi.kasice });
sidra.push({ id: "uplate", kljuc: "uplate", broj: k.brojevi.uplate });
if (!komentari.iskljuceni) sidra.push({ id: "komentari", kljuc: "komentari", broj: k.brojevi.komentari });
if (sekcijaPonuda) sidra.push({ id: "ponude", kljuc: "ponude", broj: ponude.length });

const sekcija = "scroll-mt-4 focus:outline-none";
const h2 = "text-2xl font-semibold text-ink";
const opis = (k.description ?? "").trim();
---
<Base lang={lang} title={k.title} description={opis ? obicniTekstOpisa(opis).slice(0, 160) : undefined} noindex={k.noindex}>
  {upravljanje && (
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2 rounded-md bg-mist px-4 py-2 text-sm" data-traka-upravljanja>
      <span class="text-ink-soft">{J.traka}</span>
      <a href={upravljanje} class="inline-flex min-h-11 items-center gap-2 font-semibold text-action underline-offset-2 hover:underline">
        <Settings size={16} aria-hidden="true" />{J.upravljaj}
      </a>
    </div>
  )}
  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-10">
    <div class="min-w-0">
      <Galerija lang={lang} tema={k.coverTheme} />
      <div class="mt-5"><CampaignHeader lang={lang} k={k} /></div>

      <div class="mt-5 lg:hidden">
        <CampaignStats lang={lang} k={k} />
        {!k.primaUplate && <div class="mt-3"><PausedNotice lang={lang} stanje={k.stanje} /></div>}
      </div>

      <div class="mt-6"><CampaignTabs lang={lang} sidra={sidra} /></div>

      <section id="novosti" tabindex="-1" aria-labelledby="novosti-naslov" class={`mt-8 ${sekcija}`}>
        <h2 id="novosti-naslov" class={h2}>{T.sekcije.novosti}</h2>
        <div class="mt-4"><UpdateList lang={lang} novosti={novosti} /></div>
      </section>

      <section id="opis" tabindex="-1" aria-labelledby="opis-naslov" class={`mt-10 ${sekcija}`}>
        <h2 id="opis-naslov" class={h2}>{T.sekcije.opis}</h2>
        {opis ? <div class={`mt-4 ${KLASA_OPISA}`} data-opis set:html={renderirajOpis(opis)} /> : <p class="mt-4 text-ink-muted">{T.opis.prazno}</p>}
        <div class="mt-6"><MoneyDestination lang={lang} novac={k.novac} /></div>
      </section>

      {
        k.razine.length > 0 && (
          <section id="razine" tabindex="-1" aria-labelledby="razine-naslov" class={`mt-10 ${sekcija}`}>
            <h2 id="razine-naslov" class={`flex flex-wrap items-center gap-2 ${h2}`}>{F.razine.naslov} <PhaseBadge lang={lang} /></h2>
            <p class="mt-2 max-w-[70ch] text-sm text-ink-muted">{F.razine.opis}</p>
            <ul class="mt-4 grid gap-4 sm:grid-cols-2">
              {k.razine.map((r) => (
                <li class="rounded-md bg-paper p-4 shadow-card" data-razina={r.id}>
                  <h3 class="font-semibold break-words text-ink">{r.title}</h3>
                  {r.description && <p class="mt-1 text-sm text-ink-soft">{r.description}</p>}
                  <p class="mt-2 text-sm text-ink-soft tabular-nums">
                    <strong class="text-ink">{r.priceCents === null ? F.razine.bezIznosa : novac(r.priceCents)}</strong>
                    {r.preostalo !== null && <span> · {r.preostalo === 0 ? F.razine.rasprodano : F.razine.preostalo(r.preostalo)}</span>}
                  </p>
                </li>
              ))}
            </ul>
            {novostiRazina.length > 0 && (
              <div class="mt-6">
                <h3 class="font-semibold text-ink">{F.razine.ekskluzivno}</h3>
                <p class="mt-1 max-w-[70ch] text-sm text-ink-muted">{F.razine.ekskluzivnoOpis}</p>
                <ul class="mt-3 space-y-2">
                  {novostiRazina.map((n) => (
                    <li class="flex gap-3 rounded-md bg-mist p-3" data-zakljucana-novost>
                      <LockKeyhole size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-ink-muted" />
                      <span class="min-w-0">
                        <span class="block font-medium break-words text-ink">{n.title ?? F.razine.ekskluzivno}</span>
                        <span class="block text-sm text-ink-muted">{F.razine.zakljucano(n.tierTitle)} · {formatDatuma(lang, n.publishedAt)}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )
      }

      {
        k.postavke.kasiceDopustene && (
          <section id="kasice" tabindex="-1" aria-labelledby="kasice-naslov" class={`mt-10 ${sekcija}`}>
            <h2 id="kasice-naslov" class={h2}>{T.sekcije.kasice}</h2>
            <p class="mt-2 max-w-[70ch] text-sm text-ink-muted">{T.kasice.opis}</p>
            {kasice.length === 0 ? (
              <p class="mt-4 text-ink-muted">{T.kasice.prazno}</p>
            ) : (
              <ul class="mt-4 grid gap-4 sm:grid-cols-2">
                {kasice.map((m) => <li><MoneyboxCard lang={lang} kasica={m} currency={k.currency} /></li>)}
              </ul>
            )}
            {k.stanje === "active" && (
              <a href={url(lang, "campaign.moneybox.new", { id: k.publicId })} class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-md px-4 font-semibold text-action ring-1 ring-action/30 hover:bg-mist">
                <PiggyBank size={18} aria-hidden="true" />{T.kasice.napravi}
              </a>
            )}
          </section>
        )
      }

      <section id="uplate" tabindex="-1" aria-labelledby="uplate-naslov" class={`mt-10 ${sekcija}`}>
        <h2 id="uplate-naslov" class={h2}>{T.sekcije.uplate}</h2>
        <div class="mt-4">
          <ContributorList lang={lang} uplate={uplate} currency={k.currency} samoPoVremenu={k.statistika.raisedCents === null}
            put={put} stranica={stranicaUplata} josIma={josUplata} />
        </div>
      </section>

      {
        komentari.iskljuceni ? (
          <p class="mt-10 text-ink-muted">{T.komentari.iskljuceni}</p>
        ) : (
          <section id="komentari" tabindex="-1" aria-labelledby="komentari-naslov" class={`mt-10 ${sekcija}`}>
            <h2 id="komentari-naslov" class={h2}>{T.sekcije.komentari}</h2>
            <div class="mt-4"><CommentThread lang={lang} komentari={komentari} currency={k.currency} prijava={prijava} akcija={put} komentiranje={komentiranje} /></div>
          </section>
        )
      }

      {
        sekcijaPonuda && (
          <section id="ponude" tabindex="-1" aria-labelledby="ponude-naslov" class={`mt-10 ${sekcija}`}>
            <h2 id="ponude-naslov" class={`flex flex-wrap items-center gap-2 ${h2}`}>{T.sekcije.ponude} <PhaseBadge lang={lang} /></h2>
            <p class="mt-2 max-w-[70ch] text-sm text-ink-muted">{T.ponude.opis} {F.ponude.onemoguceno}</p>
            {ponude.length === 0 ? (
              <p class="mt-4 text-ink-muted">{F.ponude.sekcija.prazno}</p>
            ) : (
              <ul class="mt-4 grid gap-4 sm:grid-cols-2">
                {ponude.map((p) => <li><KarticaPonude lang={lang} p={p} currency={k.currency} /></li>)}
              </ul>
            )}
            <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
              {k.stanje === "active" && k.postavke.ponudeDopustene && (
                <a href={`${url(lang, "offers.new")}?campaign=${k.publicId}`} class="inline-flex min-h-11 items-center gap-2 rounded-md px-4 font-semibold text-action ring-1 ring-action/30 hover:bg-mist">
                  <Plus size={18} aria-hidden="true" />{F.ponude.sekcija.dodaj}
                </a>
              )}
              <a href={url(lang, "offers")} class="inline-flex min-h-11 items-center font-semibold text-action underline underline-offset-2">{T.ponude.sve}</a>
            </div>
          </section>
        )
      }

      <section id="podijeli" tabindex="-1" aria-labelledby="podijeli-naslov" class={`mt-10 ${sekcija}`}>
        <h2 id="podijeli-naslov" class={h2}>{T.dijeljenje.naslov}</h2>
        <div class="mt-4"><ShareSheet lang={lang} adresa={adresa} naslov={k.title} /></div>
        <div class="mt-6"><PromoTools lang={lang} publicId={k.publicId} /></div>
      </section>

      <section id="prati" tabindex="-1" aria-labelledby="prati-naslov" class={`mt-10 ${sekcija}`}>
        <h2 id="prati-naslov" class={h2}>{T.prati.naslov}</h2>
        <div class="mt-3"><FollowButton lang={lang} akcija={put} pracenje={pracenje} /></div>
      </section>

      <p class="mt-10 border-t border-line pt-4">
        <a href={prijaviKampanju} class="inline-flex min-h-11 items-center gap-2 text-sm text-ink-muted underline-offset-2 hover:underline">
          <Flag size={16} aria-hidden="true" />{T.prijavi}
        </a>
      </p>
    </div>

    <div class="hidden lg:block">
      <SupportBar lang={lang} k={k} varijanta="panel" />
    </div>
  </div>
  <SupportBar lang={lang} k={k} varijanta="traka" />
</Base>
