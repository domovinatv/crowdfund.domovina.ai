---
// Moderacija komentara (ekran 22): sakrij/prikaži, odgovor organizatora ispod svakog komentara vrha.
import EyeOff from "@lucide/astro/icons/eye-off";
import OkvirUpravljanja from "../../components/upravljanje/OkvirUpravljanja.astro";
import Poruka from "../../components/upravljanje/Poruka.astro";
import { GRESKA, GUMB_MALI, H2, KARTICA, POLJE, rub } from "../../components/upravljanje/stil";
import { relativnoVrijeme } from "../../components/kampanja/format";
import { NAJVISE_KOMENTARA, type KomentarUpravljanja } from "../../lib/db/komentari";
import { UPRAVLJANJE } from "../sadrzaj/upravljanje";
import type { PodaciKomentara } from "./campaign.manage.comments.ucitaj";
import type { PropsStranice } from "../tipovi";

type Props = PropsStranice<PodaciKomentara>;
const { lang, podaci } = Astro.props;
const { u, komentari, greska, poruka } = podaci;
const T = UPRAVLJANJE[lang].komentari;
const O = UPRAVLJANJE[lang].opce;
const sad = Date.now();
const radnja = (c: KomentarUpravljanja) => (c.hiddenAt === null ? "sakrij" : "prikazi");
---
<OkvirUpravljanja lang={lang} u={u} aktivna="campaign.manage.comments">
  <h2 class={H2}>{T.naslov}</h2>
  <p class="mt-1 max-w-[70ch] text-sm text-ink-muted">{T.opis}</p>
  {u.k.postavke.komentari === "off" && <p class="mt-3 rounded-md bg-warning-bg p-3 text-sm text-warning">{T.iskljuceni}</p>}
  <Poruka vrsta="ok" tekst={poruka ? T.poruke[poruka] : null} />

  {komentari.length === 0 ? (
    <p class="mt-6 text-ink-muted">{T.prazno}</p>
  ) : (
    <ol class="mt-6 space-y-4">
      {komentari.map((c) => (
        <li class={KARTICA} id={`k-${c.id}`}>
          {[c, ...c.odgovori].map((x, i) => (
            <article class:list={[i > 0 && "mt-3 ml-4 border-l-2 border-line pl-3 sm:ml-6", x.hiddenAt !== null && "opacity-70"]}>
              <p class="flex flex-wrap items-center gap-x-2 text-sm">
                <span class="font-semibold text-ink">{x.autor ?? "—"}</span>
                {x.anonimno && <span class="text-xs italic text-ink-muted">{T.anonimno}</span>}
                {x.izDoprinosa && <span class="text-xs text-ink-muted">· {T.iznos}</span>}
                <span class="text-ink-muted">· {relativnoVrijeme(lang, x.createdAt, sad)}</span>
                {x.hiddenAt !== null && (
                  <span class="inline-flex items-center gap-1 rounded-sm bg-mist px-1.5 text-xs font-semibold text-ink-soft">
                    <EyeOff size={12} aria-hidden="true" />{T.skriven}{x.hiddenByName && ` (${T.skrio}: ${x.hiddenByName})`}
                  </span>
                )}
              </p>
              <p class="mt-1 whitespace-pre-line break-words text-ink-soft">{x.body}</p>
              <form method="post" action={u.put} class="mt-2">
                <input type="hidden" name="akcija" value={radnja(x)} />
                <input type="hidden" name="id" value={x.id} />
                <button type="submit" class={GUMB_MALI}>{x.hiddenAt === null ? T.sakrij : T.prikazi}</button>
              </form>
            </article>
          ))}
          <form method="post" action={u.put} novalidate class="mt-4">
            <input type="hidden" name="akcija" value="odgovori" />
            <input type="hidden" name="id" value={c.id} />
            <label for={`odgovor-${c.id}`} class="text-sm font-semibold text-ink">{T.odgovor}</label>
            <textarea id={`odgovor-${c.id}`} name="body" rows="2" maxlength={NAJVISE_KOMENTARA}
              aria-invalid={greska?.za === c.id ? "true" : undefined} class:list={[POLJE, rub(greska?.za === c.id)]}>{greska?.za === c.id ? greska.body : ""}</textarea>
            {greska?.za === c.id && <p class={GRESKA}>{O.greske[greska.greska]}</p>}
            <button type="submit" class={`mt-2 ${GUMB_MALI}`}>{T.odgovori}</button>
          </form>
        </li>
      ))}
    </ol>
  )}
</OkvirUpravljanja>
