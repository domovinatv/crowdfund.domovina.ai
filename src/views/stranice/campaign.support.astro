---
// Checkout korak 1 (docs/08 §5.2, obilazak 19 i 25): iznos (brzi izbor + svoj), prikaz na popisu, poruka 300 zn,
// e-pošta (prijavljenom iz sesije), „kao tvrtka” samo neprijavljenom, prihvat uvjeta. Radi bez JS-a (POST na
// istu rutu, greške uz polja); skripta samo broji znakove poruke i bira „svoj iznos” kad se u njega upisuje.
// S8: „svaki mjesec” (dan 1–28, podsjetnik ili trajni nalog) na mjesečnim kampanjama, samo prijavljenima;
// „prikaži poruku kao komentar”.
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import PiggyBank from "@lucide/astro/icons/piggy-bank";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Base from "../../layouts/Base.astro";
import CampaignStats from "../../components/kampanja/CampaignStats.astro";
import PausedNotice from "../../components/kampanja/PausedNotice.astro";
import KoraciCheckouta from "../../components/checkout/KoraciCheckouta.astro";
import { formatNovca } from "../../components/kampanja/format";
import { GRESKA, GUMB, KARTICA, OZNAKA, POLJE, POMOC, rub } from "../../components/upravljanje/stil";
import { PORUKA_NAJVISE, type PoljeCheckouta } from "../../lib/db/checkout";
import { url } from "../../lib/rute";
import { KAMPANJA } from "../sadrzaj/kampanja";
import { CHECKOUT, popuni } from "../sadrzaj/checkout";
import { PONAVLJANJE } from "../sadrzaj/ponavljanje";
import { NACINI } from "../../lib/db/ponavljanje";
import type { PodaciPodrske } from "./campaign.support.ucitaj";
import type { PropsStranice } from "../tipovi";

type Props = PropsStranice<PodaciPodrske>;
const { lang, podaci } = Astro.props;
const { k, kasica, ref, iznosi, najmanjeCenti, vrijednosti: v, greske, greskaUplate, mjesecno, ponavljanje: pv, greskePonavljanja: gp } = podaci;
const R = PONAVLJANJE[lang].checkout;
const prijavaMjesecno = `${url(lang, "sign-in")}?next=${encodeURIComponent(`${url(lang, "campaign.support", { id: k.publicId })}?ucestalost=mjesecno`)}`;
const T = CHECKOUT[lang].obrazac;
const novac = formatNovca(lang);
const korisnik = Astro.locals.korisnik;
const min = novac(najmanjeCenti);
const g = (p: PoljeCheckouta) => (greske[p] ? popuni(T.greske[greske[p]!], { min }) : undefined);
const opis = (p: PoljeCheckouta, pomoc = false) => [pomoc ? `${p}-pomoc` : "", greske[p] ? `${p}-greska` : ""].filter(Boolean).join(" ") || undefined;
const brojGresaka = Object.keys(greske).length + Object.keys(gp).length;
const MALO = "text-sm font-normal text-ink-muted";
const svojOdabran = v.izbor === "svoj" || (!v.izbor && v.svojIznos !== "");
const GUMB_IZNOSA = "flex min-h-11 cursor-pointer items-center justify-center rounded-md px-3 font-semibold tabular-nums text-ink ring-1 ring-ink-muted/50 has-[:checked]:bg-action has-[:checked]:text-paper has-[:checked]:ring-action has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-action";
---
<Base lang={lang} title={`${T.naslov} · ${k.title}`} noindex>
  <div class="mx-auto max-w-2xl">
    <a href={url(lang, "campaign", { id: k.publicId })} class="inline-flex min-h-11 items-center gap-1 text-sm font-medium text-action underline-offset-2 hover:underline">
      <ArrowLeft size={16} aria-hidden="true" />{KAMPANJA[lang].natrag}
    </a>
    <h1 class="page-title mt-2 text-ink">{T.naslov}</h1>
    {k.primaUplate && <KoraciCheckouta lang={lang} korak={1} />}

    <div class="mt-4 rounded-md bg-paper p-4 shadow-card">
      <p class="text-lg font-semibold text-ink break-words">{k.title}</p>
      <p class="text-sm text-ink-muted">{KAMPANJA[lang].organizator}: {k.organizator.name}</p>
      <CampaignStats lang={lang} k={k} class="mt-3" />
    </div>

    {
      kasica && (
        <p class="mt-4 flex gap-2 rounded-md bg-mist p-3 text-sm text-ink-soft">
          <PiggyBank size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-action" />
          <span>
            {T.kasica} <a href={url(lang, "moneybox", { alias: kasica.alias })} class="font-semibold text-ink underline underline-offset-2">{kasica.title}</a>
            {kasica.ownerName && <> {T.kasicuVodi} {kasica.ownerName}</>}.
          </span>
        </p>
      )
    }

    {
      !k.primaUplate ? (
        <div class="mt-6"><PausedNotice lang={lang} stanje={k.stanje} /></div>
      ) : (
        <form method="post" action={url(lang, "campaign.support", { id: k.publicId })} novalidate class="mt-6 space-y-6" data-checkout-obrazac>
          {kasica && <input type="hidden" name="s" value={kasica.alias} />}
          {ref && <input type="hidden" name="ref" value={ref} />}
          {brojGresaka > 0 && <p role="alert" class="rounded-md bg-danger-bg p-3 text-sm font-semibold text-danger">{T.greskeNaslov}</p>}
          {greskaUplate && (
            <p role="alert" class="rounded-md bg-danger-bg p-3 text-sm font-semibold text-danger">
              {greskaUplate === "konfig" ? T.bezKonfiguracije : T.mptGreska}
            </p>
          )}

          <fieldset class={`space-y-3 ${KARTICA}`} aria-describedby={opis("iznos", true)}>
            <legend class="text-lg font-semibold text-ink">{T.iznos}</legend>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
              {iznosi.map((c) => (
                <label class={GUMB_IZNOSA}>
                  <input type="radio" name="izbor" value={String(c)} checked={v.izbor === String(c)} class="sr-only" />
                  {novac(c)}
                </label>
              ))}
              <label class={GUMB_IZNOSA}>
                <input type="radio" name="izbor" value="svoj" checked={svojOdabran} class="sr-only" data-svoj />
                {T.svoj}
              </label>
            </div>
            <div>
              <label for="svojIznos" class={OZNAKA}>{T.svojIznos}</label>
              <div class="mt-1.5 flex max-w-xs items-stretch">
                <input id="svojIznos" name="svojIznos" type="text" inputmode="decimal" autocomplete="off" value={v.svojIznos}
                  aria-invalid={greske.iznos ? "true" : undefined} aria-describedby={opis("iznos", true)}
                  class:list={[POLJE, "mt-0 rounded-r-none", rub(greske.iznos)]} />
                <span class="inline-flex items-center rounded-r-sm border border-l-0 border-ink-muted/60 bg-mist px-3 text-ink-soft">€</span>
              </div>
            </div>
            <p id="iznos-pomoc" class={POMOC}>{popuni(T.raspon, { min })}</p>
            {g("iznos") && <p id="iznos-greska" class={GRESKA}>{g("iznos")}</p>}
          </fieldset>

          {mjesecno && (
            <fieldset class={`space-y-4 ${KARTICA}`} data-ucestalost>
              <legend class="text-lg font-semibold text-ink">{R.ucestalost}</legend>
              <div class="grid grid-cols-2 gap-2">
                <label class={GUMB_IZNOSA}>
                  <input type="radio" name="ucestalost" value="jednom" checked={pv.ucestalost !== "mjesecno"} class="sr-only" />
                  {R.jednom}
                </label>
                <label class={GUMB_IZNOSA}>
                  <input type="radio" name="ucestalost" value="mjesecno" checked={pv.ucestalost === "mjesecno"} class="sr-only"
                    aria-describedby="ucestalost-pomoc" />
                  {R.mjesecno}
                </label>
              </div>
              <p id="ucestalost-pomoc" class={POMOC}>{R.mjesecnoPomoc}</p>
              {gp.ucestalost && <p id="ucestalost-greska" role="alert" class={GRESKA}>{R.greske[gp.ucestalost]}</p>}
              {korisnik ? (
                <div class="space-y-4" data-mjesecno-polja>
                  <div>
                    <label for="dan" class={OZNAKA}>{R.dan}</label>
                    <select id="dan" name="dan" aria-describedby={["dan-pomoc", gp.dan ? "dan-greska" : ""].filter(Boolean).join(" ")}
                      aria-invalid={gp.dan ? "true" : undefined} class:list={[POLJE, "max-w-32", rub(gp.dan)]}>
                      {Array.from({ length: 28 }, (_, i) => i + 1).map((d) => (
                        <option value={String(d)} selected={pv.dan === String(d) || (!pv.dan && d === Math.min(28, new Date().getUTCDate()))}>{d}.</option>
                      ))}
                    </select>
                    <p id="dan-pomoc" class={POMOC}>{R.danPomoc}</p>
                    {gp.dan && <p id="dan-greska" class={GRESKA}>{R.greske[gp.dan]}</p>}
                  </div>
                  <fieldset>
                    <legend class={OZNAKA}>{R.nacin}</legend>
                    <div class="mt-2 space-y-3">
                      {NACINI.map((n) => (
                        <label class="flex gap-3">
                          <input type="radio" name="nacin" value={n} checked={pv.nacin === n} class="mt-1 size-5 shrink-0 accent-action" />
                          <span>
                            <span class="block text-ink">{R.nacini[n]}</span>
                            <span class="block text-sm text-ink-muted">{R.naciniPomoc[n]}</span>
                          </span>
                        </label>
                      ))}
                    </div>
                    {gp.nacin && <p class={GRESKA}>{R.greske[gp.nacin]}</p>}
                  </fieldset>
                </div>
              ) : (
                <p class="text-sm text-ink-soft">
                  {R.prijavaZaMjesecno} <a href={prijavaMjesecno} class="font-semibold text-action underline underline-offset-2">{R.prijava}</a>
                </p>
              )}
            </fieldset>
          )}

          <fieldset class={`space-y-4 ${KARTICA}`}>
            <legend class="text-lg font-semibold text-ink">{T.vidljivost}</legend>
            <label class="flex gap-3">
              <input name="skrijIme" type="checkbox" value="1" checked={v.skrijIme} class="mt-1 size-5 shrink-0 accent-action" />
              <span class="text-ink">{T.skrijIme}</span>
            </label>
            <label class="flex gap-3">
              <input name="skrijIznos" type="checkbox" value="1" checked={v.skrijIznos} class="mt-1 size-5 shrink-0 accent-action" />
              <span class="text-ink">{T.skrijIznos}</span>
            </label>
            <div>
              <label for="poruka" class={OZNAKA}>{T.poruka} <span class={MALO}>({T.neobavezno})</span></label>
              <textarea id="poruka" name="poruka" rows="4" maxlength={PORUKA_NAJVISE}
                aria-invalid={greske.poruka ? "true" : undefined} aria-describedby={["poruka-brojac", greske.poruka ? "poruka-greska" : ""].filter(Boolean).join(" ")}
                class:list={[POLJE, rub(greske.poruka)]}>{v.poruka}</textarea>
              <p id="poruka-brojac" class={`${POMOC} text-right tabular-nums`} data-brojac={T.brojac} aria-live="polite">{popuni(T.brojac, { n: [...v.poruka].length })}</p>
              {g("poruka") && <p id="poruka-greska" class={GRESKA}>{g("poruka")}</p>}
            </div>
            <label class="flex gap-3">
              <input name="komentar" type="checkbox" value="1" checked={v.komentar} aria-describedby="komentar-pomoc" class="mt-1 size-5 shrink-0 accent-action" />
              <span>
                <span class="block text-ink">{R.komentar}</span>
                <span id="komentar-pomoc" class="block text-sm text-ink-muted">{R.komentarPomoc}</span>
              </span>
            </label>
          </fieldset>

          <fieldset class={`space-y-4 ${KARTICA}`}>
            <legend class="text-lg font-semibold text-ink">{T.podaci}</legend>
            {korisnik ? (
              <>
                <p class="text-ink">{popuni(T.emailPrijavljen, { email: korisnik.email })}</p>
                <p class="text-sm text-ink-soft">{popuni(T.naPopisu, { ime: korisnik.ime })}</p>
              </>
            ) : (
              <>
                <div>
                  <label for="email" class={OZNAKA}>{T.email} <span class={MALO}>({T.obavezno})</span></label>
                  <input id="email" name="email" type="email" required autocomplete="email" maxlength="254" value={v.email}
                    aria-invalid={greske.email ? "true" : undefined} aria-describedby={opis("email", true)} class:list={[POLJE, rub(greske.email)]} />
                  <p id="email-pomoc" class={POMOC}>{T.emailPomoc}</p>
                  {g("email") && <p id="email-greska" class={GRESKA}>{g("email")}</p>}
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label for="ime" class={OZNAKA}>{T.ime} <span class={MALO}>({T.neobavezno})</span></label>
                    <input id="ime" name="ime" type="text" autocomplete="given-name" maxlength="100" value={v.ime}
                      aria-invalid={greske.ime ? "true" : undefined} aria-describedby={opis("ime")} class:list={[POLJE, rub(greske.ime)]} />
                    {g("ime") && <p id="ime-greska" class={GRESKA}>{g("ime")}</p>}
                  </div>
                  <div>
                    <label for="prezime" class={OZNAKA}>{T.prezime} <span class={MALO}>({T.neobavezno})</span></label>
                    <input id="prezime" name="prezime" type="text" autocomplete="family-name" maxlength="100" value={v.prezime}
                      aria-invalid={greske.prezime ? "true" : undefined} aria-describedby={opis("prezime")} class:list={[POLJE, rub(greske.prezime)]} />
                    {g("prezime") && <p id="prezime-greska" class={GRESKA}>{g("prezime")}</p>}
                  </div>
                </div>
                <label class="flex gap-3">
                  <input name="kaoTvrtka" type="checkbox" value="1" checked={v.kaoTvrtka} class="mt-1 size-5 shrink-0 accent-action" />
                  <span class="text-ink">{T.kaoTvrtka}</span>
                </label>
                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label for="tvrtka" class={OZNAKA}>{T.tvrtka}</label>
                    <input id="tvrtka" name="tvrtka" type="text" autocomplete="organization" maxlength="200" value={v.tvrtka}
                      aria-invalid={greske.tvrtka ? "true" : undefined} aria-describedby={opis("tvrtka")} class:list={[POLJE, rub(greske.tvrtka)]} />
                    {g("tvrtka") && <p id="tvrtka-greska" class={GRESKA}>{g("tvrtka")}</p>}
                  </div>
                  <div>
                    <label for="oib" class={OZNAKA}>{T.oib} <span class={MALO}>({T.neobavezno})</span></label>
                    <input id="oib" name="oib" type="text" inputmode="numeric" maxlength="11" pattern="[0-9]{11}" autocomplete="off" value={v.oib}
                      aria-invalid={greske.oib ? "true" : undefined} aria-describedby={opis("oib", true)} class:list={[POLJE, "font-mono", rub(greske.oib)]} />
                    <p id="oib-pomoc" class={POMOC}>{T.oibPomoc}</p>
                    {g("oib") && <p id="oib-greska" class={GRESKA}>{g("oib")}</p>}
                  </div>
                </div>
                <div>
                  <label class="flex gap-3">
                    <input name="uvjeti" type="checkbox" value="1" checked={v.uvjeti} required
                      aria-invalid={greske.uvjeti ? "true" : undefined} aria-describedby={opis("uvjeti")} class="mt-1 size-5 shrink-0 accent-action" />
                    <span class="text-ink">
                      {T.uvjeti} <a href={url(lang, "terms")} class="font-semibold text-action underline underline-offset-2">{T.uvjetiPoveznica}</a> {T.i}
                      <a href={url(lang, "privacy")} class="font-semibold text-action underline underline-offset-2">{T.privatnostPoveznica}</a>
                    </span>
                  </label>
                  {g("uvjeti") && <p id="uvjeti-greska" class={GRESKA}>{g("uvjeti")}</p>}
                </div>
              </>
            )}
          </fieldset>

          <section aria-labelledby="sazetak" class={KARTICA}>
            <h2 id="sazetak" class="text-lg font-semibold text-ink">{T.sazetak}</h2>
            <dl class="mt-2 grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-1 text-ink">
              <dt>{T.provizija}</dt><dd class="tabular-nums">{T.nula}</dd>
            </dl>
            <p class="mt-2 text-sm text-ink-muted">{T.napojnicaNapomena}</p>
          </section>

          <button type="submit" class={GUMB}>{T.gumb}</button>
        </form>
      )
    }

    <p class="mt-6 flex gap-2 text-sm text-ink-muted">
      <ShieldCheck size={18} aria-hidden="true" class="mt-0.5 shrink-0" />{T.novac}
    </p>
  </div>
</Base>

<script>
  // Poboljšanje uz JS: brojač znakova poruke i odabir „svoj iznos” kad se upisuje iznos.
  for (const obrazac of document.querySelectorAll<HTMLFormElement>("[data-checkout-obrazac]")) {
    const poruka = obrazac.querySelector<HTMLTextAreaElement>("#poruka");
    const brojac = obrazac.querySelector<HTMLElement>("[data-brojac]");
    if (poruka && brojac) {
      const uzorak = brojac.dataset.brojac ?? "{n}";
      poruka.addEventListener("input", () => (brojac.textContent = uzorak.replace("{n}", String([...poruka.value].length))));
    }
    const svoj = obrazac.querySelector<HTMLInputElement>("#svojIznos");
    const radio = obrazac.querySelector<HTMLInputElement>("[data-svoj]");
    if (svoj && radio) {
      svoj.addEventListener("input", () => {
        if (svoj.value.trim()) radio.checked = true;
      });
      for (const r of obrazac.querySelectorAll<HTMLInputElement>('input[name="izbor"]')) {
        if (r !== radio) r.addEventListener("change", () => (svoj.value = ""));
      }
    }
  }
</script>
