---
// Praćenje kampanje (ekran 22): što se prati i poveznica na odjavu. Bez e-pošte i imena pratitelja.
import Bell from "@lucide/astro/icons/bell";
import BellOff from "@lucide/astro/icons/bell-off";
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/rute";
import { PRACENJE } from "../sadrzaj/prijava-sadrzaja";
import type { PodaciPracenja } from "./follow.ucitaj";
import type { PropsStranice } from "../tipovi";

type Props = PropsStranice<PodaciPracenja>;
const { lang, podaci } = Astro.props;
const { p, token } = podaci;
const T = PRACENJE[lang];
const stavke = [
  { naziv: T.novosti, ukljuceno: p.obavijesti.novosti },
  { naziv: T.komentari, ukljuceno: p.obavijesti.komentari },
  { naziv: T.kraj, ukljuceno: p.obavijesti.kraj },
];
---
<Base lang={lang} title={T.naslov} noindex>
  <div class="mx-auto max-w-2xl">
    <h1 class="page-title text-ink">{T.naslov}</h1>
    <p class="mt-3 text-ink-soft">
      {T.pratite}:{" "}
      {p.kampanjaVidljiva
        ? <a href={url(lang, "campaign", { id: p.publicId })} class="font-semibold text-ink underline underline-offset-2 break-words">{p.title}</a>
        : <strong class="text-ink break-words">{p.title}</strong>}
    </p>
    {!p.kampanjaVidljiva && <p class="mt-2 text-sm text-ink-muted">{T.nevidljiva}</p>}

    <section aria-labelledby="obavijesti" class="mt-6 rounded-md bg-paper p-4 shadow-card">
      <h2 id="obavijesti" class="text-lg font-semibold text-ink">{T.obavijesti}</h2>
      <ul class="mt-3 divide-y divide-line">
        {stavke.map((s) => (
          <li class="flex items-center justify-between gap-3 py-2">
            <span class="text-ink">{s.naziv}</span>
            <span class:list={["inline-flex items-center gap-1 text-sm font-semibold", s.ukljuceno ? "text-success" : "text-ink-muted"]}>
              {s.ukljuceno ? <Bell size={16} aria-hidden="true" /> : <BellOff size={16} aria-hidden="true" />}
              {s.ukljuceno ? T.ukljuceno : T.iskljuceno}
            </span>
          </li>
        ))}
      </ul>
      {!p.aktivno && <p class="mt-3 text-sm text-ink-muted">{T.neaktivno}</p>}
      <p class="mt-3 text-sm text-ink-muted">{T.promjene}</p>
    </section>

    {
      p.aktivno && (
        <a href={url(lang, "follow.unsubscribe", { token })} class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-md px-4 font-semibold text-action ring-1 ring-action/30 hover:bg-mist">
          <BellOff size={18} aria-hidden="true" />{T.odjava}
        </a>
      )
    }
  </div>
</Base>
