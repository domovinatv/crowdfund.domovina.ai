---
// Generator widgeta (pregled §4.4): postavke kao GET obrazac (radi bez JS-a), HTML kod i pregled iframea.
// S10 (B09): veličina i izgled; overlay za stream (`#stream`, iz PromoTools).
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import Base from "../../layouts/Base.astro";
import { LANGS, prevoditelj } from "../../i18n";
import { IZGLEDI_WIDGETA, VELICINE_WIDGETA, type VelicinaWidgeta } from "../../components/kampanja/dijeljenje";
import { url } from "../../lib/rute";
import { KAMPANJA, PODRUTE } from "../sadrzaj/kampanja";
import type { PodaciWidgeta } from "./campaign.widget.ucitaj";
import type { PropsStranice } from "../tipovi";

type Props = PropsStranice<PodaciWidgeta>;
const { lang, podaci } = Astro.props;
const { k, jezik, target, velicina, izgled, dimenzije, kod, pregled, stream } = podaci;
const T = PODRUTE[lang].widget;
const t = prevoditelj(lang);
const radio = "flex min-h-11 items-center gap-2 rounded-md px-3 ring-1 ring-line has-[:checked]:bg-mist has-[:checked]:ring-action";
---
<Base lang={lang} title={`${T.naslov} · ${k.title}`} noindex>
  <a href={url(lang, "campaign", { id: k.publicId })} class="inline-flex min-h-11 items-center gap-1 text-sm font-medium text-action underline-offset-2 hover:underline">
    <ArrowLeft size={16} aria-hidden="true" />{KAMPANJA[lang].natrag}
  </a>
  <h1 class="page-title mt-2 text-ink">{T.naslov}</h1>
  <p class="mt-1 text-lg text-ink-soft break-words">{k.title}</p>
  <p class="mt-3 max-w-[70ch] text-ink-soft">{T.uvod}</p>

  <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_24rem]">
    <div class="min-w-0">
      <form method="get" action={url(lang, "campaign.widget", { id: k.publicId })} class="space-y-5">
        <h2 class="text-xl font-semibold text-ink">{T.postavke}</h2>
        <fieldset>
          <legend class="font-semibold text-ink">{T.jezik}</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {LANGS.map((l) => (
              <label class={radio}><input type="radio" name="lang" value={l} checked={jezik === l} /> {t(`lang.${l}`)}</label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend class="font-semibold text-ink">{T.cilj}</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            <label class={radio}><input type="radio" name="target" value="campaign" checked={target === "campaign"} /> {T.ciljKampanja}</label>
            <label class={radio}><input type="radio" name="target" value="support" checked={target === "support"} /> {T.ciljPodrska}</label>
          </div>
        </fieldset>
        <fieldset>
          <legend class="font-semibold text-ink">{T.velicina}</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {(Object.keys(VELICINE_WIDGETA) as VelicinaWidgeta[]).map((v) => (
              <label class={radio}><input type="radio" name="size" value={v} checked={velicina === v} /> {T.velicine[v]}</label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend class="font-semibold text-ink">{T.izgled}</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {IZGLEDI_WIDGETA.map((i) => (
              <label class={radio}><input type="radio" name="theme" value={i} checked={izgled === i} /> {T.izgledi[i]}</label>
            ))}
          </div>
        </fieldset>
        <button type="submit" class="inline-flex min-h-11 items-center rounded-md bg-action px-5 font-semibold text-paper hover:bg-action-strong">{T.primijeni}</button>
      </form>

      <div class="mt-8">
        <label for="kod-widgeta" class="text-xl font-semibold text-ink">{T.kod}</label>
        <textarea id="kod-widgeta" readonly rows="5" aria-describedby="kod-pomoc"
          class="mt-2 block w-full rounded-sm border border-ink-muted/60 bg-mist p-3 font-mono text-sm text-ink">{kod}</textarea>
        <p id="kod-pomoc" class="mt-1 text-sm text-ink-muted">{T.kodPomoc}</p>
      </div>
    </div>

    <section aria-labelledby="pregled-widgeta">
      <h2 id="pregled-widgeta" class="text-xl font-semibold text-ink">{T.pregled}</h2>
      <iframe src={pregled} title={`${T.pregled}: ${k.title}`} width={dimenzije.w} height={dimenzije.h} loading="lazy"
        style={`max-width:${dimenzije.w}px`} class="mt-3 block w-full rounded-md border-0 bg-mist" data-pregled-widgeta={`${velicina}-${izgled}`}></iframe>
    </section>
  </div>

  <section id="stream" aria-labelledby="stream-naslov" class="mt-12 max-w-2xl scroll-mt-20">
    <h2 id="stream-naslov" class="text-xl font-semibold text-ink">{T.streamNaslov}</h2>
    <p class="mt-2 text-ink-soft">{T.streamUvod}</p>
    <label for="adresa-streama" class="mt-4 block font-semibold text-ink">{T.streamAdresa}</label>
    <input id="adresa-streama" type="url" readonly value={stream} aria-describedby="stream-pomoc"
      class="mt-1.5 block w-full rounded-sm border border-ink-muted/60 bg-mist px-3 py-2.5 font-mono text-sm text-ink" />
    <p id="stream-pomoc" class="mt-1 text-sm text-ink-muted">{T.streamPomoc}</p>
    <a href={stream} target="_blank" rel="noopener" class="mt-2 inline-flex min-h-11 items-center font-semibold text-action underline underline-offset-2">{T.streamOtvori}</a>
  </section>
</Base>
