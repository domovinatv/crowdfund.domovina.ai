---
// Dijeljenje bez JS-a (docs/08 §3.2 ShareSheet): poveznica u polju samo za čitanje, e-pošta (`mailto:`),
// WhatsApp, Facebook, LinkedIn kao obične poveznice; bez vanjskih skripti i slika.
import Mail from "@lucide/astro/icons/mail";
import MessageCircle from "@lucide/astro/icons/message-circle";
import Share2 from "@lucide/astro/icons/share-2";
import type { Lang } from "../../i18n";
import { KAMPANJA } from "../../views/sadrzaj/kampanja";
import { poveznice } from "./dijeljenje";

interface Props {
  lang: Lang;
  /** Apsolutna adresa koja se dijeli. */
  adresa: string;
  naslov: string;
  idPolja?: string;
}
const { lang, adresa, naslov, idPolja = "poveznica-kampanje" } = Astro.props;
const T = KAMPANJA[lang].dijeljenje;
const IKONE = { email: Mail, whatsapp: MessageCircle, facebook: Share2, linkedin: Share2 };
---
<div>
  <label for={idPolja} class="font-semibold text-ink">{T.poveznica}</label>
  <input id={idPolja} type="url" readonly value={adresa} aria-describedby={`${idPolja}-pomoc`}
    class="mt-1.5 block w-full rounded-sm border border-ink-muted/60 bg-mist px-3 py-2.5 font-mono text-sm text-ink" />
  <p id={`${idPolja}-pomoc`} class="mt-1 text-sm text-ink-muted">{T.poveznicaPomoc}</p>
  <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
    {
      poveznice(adresa, naslov).map((p) => {
        const Ikona = IKONE[p.kljuc];
        const vanjska = p.kljuc !== "email";
        return (
          <li>
            <a href={p.href} rel={vanjska ? "noopener noreferrer" : undefined} target={vanjska ? "_blank" : undefined}
              class="flex min-h-11 items-center justify-center gap-2 rounded-md px-3 font-medium text-action ring-1 ring-action/30 hover:bg-mist">
              <Ikona size={18} aria-hidden="true" />{T[p.kljuc]}
              {vanjska && <span class="sr-only">{T.novaKartica}</span>}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>
