---
// Praćenje kampanje (docs/08 §3.2 FollowButton): neprijavljeni upisuje e-poštu. Spremanje (tri prekidača,
// potvrda e-poštom) je S6; POST zasad samo vraća poruku i ništa ne zapisuje.
import Bell from "@lucide/astro/icons/bell";
import Hourglass from "@lucide/astro/icons/hourglass";
import type { Lang } from "../../i18n";
import { KAMPANJA } from "../../views/sadrzaj/kampanja";

interface Props {
  lang: Lang;
  /** Put stranice kampanje (POST ide na nju). */
  akcija: string;
  poslano: boolean;
}
const { lang, akcija, poslano } = Astro.props;
const T = KAMPANJA[lang].prati;
---
<div>
  <p class="text-ink-soft">{T.tekst}</p>
  {
    poslano && (
      <p role="status" class="mt-3 flex gap-2 rounded-md bg-warning-bg p-3 text-sm text-warning ring-1 ring-warning/25 ring-inset">
        <Hourglass size={18} aria-hidden="true" class="mt-0.5 shrink-0" />{T.s6}
      </p>
    )
  }
  <form method="post" action={`${akcija}#prati`} class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-end">
    <input type="hidden" name="akcija" value="prati" />
    <div class="min-w-0 flex-1">
      <label for="prati-eposta" class="text-sm font-semibold text-ink">{T.eposta}</label>
      <input id="prati-eposta" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254"
        class="mt-1 block w-full rounded-sm border border-ink-muted/60 bg-paper px-3 py-2.5 text-base text-ink" />
    </div>
    <button type="submit" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-action px-5 font-semibold text-paper hover:bg-action-strong">
      <Bell size={18} aria-hidden="true" />{T.gumb}
    </button>
  </form>
</div>
