---
// Praćenje kampanje (docs/08 §3.2 FollowButton, ekran 22): tri prekidača (komentari, novosti, kraj). Prijavljeni
// sprema odmah (sve isključeno = odjava); neprijavljeni upisuje e-poštu i dobiva poveznicu za potvrdu (demo
// pošta: ništa se ne šalje, poveznica je prikazana ovdje). POST na stranicu kampanje, bez JS-a.
import Bell from "@lucide/astro/icons/bell";
import Mail from "@lucide/astro/icons/mail";
import Poruka from "../upravljanje/Poruka.astro";
import { GRESKA, GUMB, POLJE, POMOC, rub } from "../upravljanje/stil";
import type { Lang } from "../../i18n";
import type { StanjePracenja } from "../../views/stranice/campaign.ucitaj";
import { UPRAVLJANJE } from "../../views/sadrzaj/upravljanje";

interface Props {
  lang: Lang;
  /** Put stranice kampanje (POST ide na nju). */
  akcija: string;
  pracenje: StanjePracenja;
}
const { lang, akcija, pracenje: p } = Astro.props;
const T = UPRAVLJANJE[lang].javno.prati;
const prekidaci = [
  { ime: "komentari", oznaka: T.komentari, opis: T.komentariOpis },
  { ime: "novosti", oznaka: T.novosti, opis: T.novostiOpis },
  { ime: "kraj", oznaka: T.kraj, opis: T.krajOpis },
] as const;
---
<div>
  <Poruka vrsta="ok" tekst={p.poruka ? T.poruke[p.poruka] : null} />
  <Poruka vrsta="greska" tekst={p.greska === "nista" ? T.greske.nista : null} />
  {p.demoLink && (
    <aside aria-label={T.demoNaslov} class="mt-3 rounded-md border border-dashed border-ink-muted/60 bg-mist p-3 text-sm" data-demo-posta>
      <p class="flex items-center gap-2 font-semibold text-ink"><Mail size={16} aria-hidden="true" />{T.demoNaslov}</p>
      <p class="mt-1 text-ink-soft">{T.demoTekst.replace("{email}", p.demoEmail ?? "")}</p>
      <a href={p.demoLink} class="mt-2 inline-flex min-h-11 items-center font-semibold text-action underline underline-offset-2">{T.demoLink}</a>
    </aside>
  )}
  <form method="post" action={`${akcija}#prati`} novalidate class="mt-3 space-y-4">
    <input type="hidden" name="akcija" value="prati" />
    <fieldset>
      <legend class="text-ink-soft">{T.tekst}</legend>
      <div class="mt-3 space-y-3">
        {prekidaci.map((x) => (
          <div class="flex gap-3">
            <input id={`prati-${x.ime}`} name={x.ime} type="checkbox" value="1" checked={p.obavijesti[x.ime]}
              aria-describedby={`prati-${x.ime}-opis`} class="mt-1 size-5 shrink-0 accent-action" />
            <div>
              <label for={`prati-${x.ime}`} class="font-semibold text-ink">{x.oznaka}</label>
              <p id={`prati-${x.ime}-opis`} class={`${POMOC} mt-0`}>{x.opis}</p>
            </div>
          </div>
        ))}
      </div>
    </fieldset>
    {p.prijavljen ? (
      <p class={POMOC}>{T.prijavljen}</p>
    ) : (
      <div class="max-w-md">
        <label for="prati-eposta" class="text-sm font-semibold text-ink">{T.email}</label>
        <input id="prati-eposta" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" value={p.email}
          aria-invalid={p.greska === "email" ? "true" : undefined} aria-describedby={p.greska === "email" ? "prati-eposta-greska" : undefined}
          class:list={[POLJE, "mt-1", rub(p.greska === "email")]} />
        {p.greska === "email" && <p id="prati-eposta-greska" class={GRESKA}>{T.greske.email}</p>}
      </div>
    )}
    <button type="submit" class={GUMB}><Bell size={18} aria-hidden="true" />{T.spremi}</button>
  </form>
</div>
