---
// „Podrži” i „Podijeli” (docs/08 §3.2 SupportBar, §5.1): na mobitelu ljepljiva donja traka, na desktopu
// (lg+) ljepljivi bočni panel s brojkama. Kampanja koja ne prima uplate umjesto gumba dobiva PausedNotice.
import Bell from "@lucide/astro/icons/bell";
import Heart from "@lucide/astro/icons/heart";
import PiggyBank from "@lucide/astro/icons/piggy-bank";
import Share2 from "@lucide/astro/icons/share-2";
import type { Lang } from "../../i18n";
import type { StranicaKampanje } from "../../lib/db/kampanja";
import { url } from "../../lib/rute";
import { KAMPANJA } from "../../views/sadrzaj/kampanja";
import CampaignStats from "./CampaignStats.astro";
import PausedNotice from "./PausedNotice.astro";

interface Props {
  lang: Lang;
  k: StranicaKampanje;
  varijanta: "traka" | "panel";
}
const { lang, k, varijanta } = Astro.props;
const T = KAMPANJA[lang];
const podrzi = k.primaUplate ? url(lang, "campaign.support", { id: k.publicId }) : null;
const stanje = k.stanje;
const gumb = "inline-flex min-h-11 items-center justify-center gap-2 rounded-md px-4 font-semibold";
---
{
  varijanta === "traka" ? (
    <div class="podrska-traka fixed inset-x-0 bottom-0 z-20 border-t border-line bg-paper/95 px-4 py-3 shadow-raised backdrop-blur lg:hidden">
      <div class="mx-auto flex max-w-xl items-center gap-2">
        {podrzi ? (
          <a href={podrzi} class={`${gumb} flex-1 bg-action text-paper hover:bg-action-strong`}>
            <Heart size={18} aria-hidden="true" />{T.podrska.podrzi}
          </a>
        ) : (
          <div class="min-w-0 flex-1"><PausedNotice lang={lang} stanje={stanje} sazeto /></div>
        )}
        <a href="#podijeli" class={`${gumb} text-action ring-1 ring-action/30 hover:bg-mist`}>
          <Share2 size={18} aria-hidden="true" />{T.podrska.podijeli}
        </a>
      </div>
    </div>
  ) : (
    <aside aria-label={T.statistika.naslov} class="rounded-md bg-paper p-5 shadow-raised lg:sticky lg:top-4">
      <CampaignStats lang={lang} k={k} />
      <div class="mt-4 space-y-2">
        {podrzi ? (
          <a href={podrzi} class={`${gumb} w-full bg-action text-lg text-paper hover:bg-action-strong`}>
            <Heart size={20} aria-hidden="true" />{T.podrska.podrziKampanju}
          </a>
        ) : (
          <PausedNotice lang={lang} stanje={stanje} />
        )}
        <div class="grid grid-cols-2 gap-2">
          <a href="#podijeli" class={`${gumb} text-action ring-1 ring-action/30 hover:bg-mist`}>
            <Share2 size={18} aria-hidden="true" />{T.podrska.podijeli}
          </a>
          <a href="#prati" class={`${gumb} text-action ring-1 ring-action/30 hover:bg-mist`}>
            <Bell size={18} aria-hidden="true" />{T.prati.gumb}
          </a>
        </div>
        {k.postavke.kasiceDopustene && k.stanje === "active" && (
          <a href={url(lang, "campaign.moneybox.new", { id: k.publicId })} class={`${gumb} w-full text-ink-soft hover:bg-mist`}>
            <PiggyBank size={18} aria-hidden="true" />{T.kasice.napravi}
          </a>
        )}
      </div>
      {podrzi && <p class="mt-3 text-xs text-ink-muted">{T.podrska.bezProvizije}</p>}
    </aside>
  )
}
<style is:global>
  /* Traka je fiksna: podnožje stranice ne smije ostati ispod nje (samo do lg, gdje je panel). */
  @layer base {
    @media (width < 64rem) {
      body:has(.podrska-traka) {
        padding-bottom: 5rem;
      }
    }
  }
</style>
