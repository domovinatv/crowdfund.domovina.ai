---
// „Kamo ide novac” (docs/08 §3.2, odluka 203): Safe organizacije, mreža, prag potpisa, 0 potpisnika
// platforme. Platforma ne drži novac ni ključeve.
import ExternalLink from "@lucide/astro/icons/external-link";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import type { Lang } from "../../i18n";
import type { StranicaKampanje } from "../../lib/db/kampanja";
import { KAMPANJA } from "../../views/sadrzaj/kampanja";
import { skratiAdresu } from "./format";

interface Props {
  lang: Lang;
  novac: StranicaKampanje["novac"];
}
const { lang, novac } = Astro.props;
const T = KAMPANJA[lang].novac;
const EXPLORER: Record<number, string> = {
  100: "https://gnosisscan.io/address/",
  10200: "https://gnosis-chiado.blockscout.com/address/",
};
const explorer = novac && EXPLORER[novac.chainId] ? `${EXPLORER[novac.chainId]}${novac.safeAddress}` : null;
---
<div class="rounded-md bg-mist p-4">
  <h3 class="flex items-center gap-2 text-lg font-semibold text-ink">
    <ShieldCheck size={20} aria-hidden="true" class="text-action" />{T.naslov}
  </h3>
  <p class="mt-2 text-sm text-ink-soft">{T.tekst}</p>
  {
    novac ? (
      <>
        <dl class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm">
          <dt class="text-ink-muted">{T.safe}</dt>
          <dd class="font-mono text-ink" title={novac.safeAddress}>{skratiAdresu(novac.safeAddress)}</dd>
          <dt class="text-ink-muted">{T.mreza}</dt>
          <dd class="text-ink">{novac.mreza}</dd>
          {novac.threshold > 0 && (<><dt class="text-ink-muted">{T.potpisi}</dt><dd class="text-ink tabular-nums">{novac.threshold}</dd></>)}
          <dt class="text-ink-muted">{T.platforma}</dt>
          <dd class="font-semibold text-success tabular-nums">0</dd>
        </dl>
        <p class:list={["mt-3 text-sm", novac.provjeren ? "text-success" : "text-warning"]}>{novac.provjeren ? T.provjeren : T.neprovjeren}</p>
        {explorer && (
          <a href={explorer} rel="noopener noreferrer" target="_blank" class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-action underline underline-offset-2">
            {T.explorer}<ExternalLink size={14} aria-hidden="true" />
          </a>
        )}
      </>
    ) : (
      <p class="mt-3 text-sm text-warning">{T.nema}</p>
    )
  }
</div>
