---
// Brojke kampanje (docs/08 §3.2): prikupljeno, cilj, %, podržavatelji, dani. Skrivena vrijednost (null,
// odluka 406) se ne prikazuje, nikad kao 0.
import ProgressBar from "../ProgressBar.astro";
import type { Lang } from "../../i18n";
import type { StranicaKampanje } from "../../lib/db/kampanja";
import { KAMPANJA, mnozina } from "../../views/sadrzaj/kampanja";
import { formatNovca } from "./format";

interface Props {
  lang: Lang;
  k: StranicaKampanje;
  class?: string;
}
const { lang, k, class: klasa = "" } = Astro.props;
const T = KAMPANJA[lang].statistika;
const novac = formatNovca(lang, k.currency);
const s = k.statistika;
let rok: string;
if (k.endsAt === null) rok = T.bezRoka;
else if (k.rokIstekao) rok = T.rokProsao;
else if (k.daysLeft === 0) rok = T.zadnjiDan;
else rok = mnozina(lang, k.daysLeft ?? 0, T.dana);
---
<div class={klasa}>
  <h2 class="sr-only">{T.naslov}</h2>
  {
    s.raisedCents !== null && (
      <p class="tabular-nums">
        <strong class="text-2xl font-bold text-ink" data-prikupljeno-centi={s.raisedCents}>{novac(s.raisedCents)}</strong>
        <span class="text-ink-soft"> {T.prikupljeno}</span>
        {k.goalCents ? <span class="block text-sm text-ink-muted">{T.od} {novac(k.goalCents)}</span> : <span class="block text-sm text-ink-muted">{T.bezCilja}</span>}
      </p>
    )
  }
  <ProgressBar lang={lang} raisedCents={s.raisedCents} goalCents={k.goalCents} showLabel class="mt-3" />
  <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-ink-soft tabular-nums">
    {s.contributorCount !== null && <li>{mnozina(lang, s.contributorCount, T.podrzavatelja)}</li>}
    {k.kind === "recurring" && <li>{T.mjesecno}</li>}
    {k.stanje !== "closed" && <li>{rok}</li>}
  </ul>
</div>
