---
// Zaštita obrasca od neželjenih poruka: mjesto za Cloudflare Turnstile (kontakt, registracija). U prototipu je
// mock: skriveno polje `cf-turnstile-response` s vrijednošću `mock-prototip`, poslužitelj ga ne provjerava
// (kontakt i registracija isto; prava provjera `siteverify` dolazi s produkcijskim ključevima, docs/11).
import ShieldCheck from "@lucide/astro/icons/shield-check";

interface Props {
  naslov: string;
  tekst: string;
}
const { naslov, tekst } = Astro.props;
---
<fieldset class="rounded-md border border-dashed border-ink-muted/60 p-4" data-mock="turnstile">
  <legend class="px-1 text-sm font-semibold text-ink">{naslov}</legend>
  <p class="flex gap-2 text-sm text-ink-muted">
    <ShieldCheck size={18} aria-hidden="true" class="mt-0.5 shrink-0" />
    <span>{tekst}</span>
  </p>
  <input type="hidden" name="cf-turnstile-response" value="mock-prototip" />
</fieldset>
