---
// Upute za uplatu jednog intenta (docs/08 §3.3 `QrPanel` + `PaymentStatus`), za doprinos i za napojnicu.
// Produkcija (odluka 704): QR iz `epc_qr_data`, IBAN, primatelj, referenca. Sandbox: oznaka „ne šalji novac”,
// QR na MPT `checkout_url` i gumbi simulacije (form POST na `api/checkouts/{id}/simulate`, agent A).
// Stanje uživo (S11): `EventSource` na `GET /api/checkouts/{id}/stream` (Worker proxyja MPT SSE, jer rail nema
// CORS za naš origin); dok stream ne javi prvi događaj ili kad padne, pull `GET …/events` svake 3 s (odluka 705).
// Promjena stanja: pull (upisuje u bazu) pa poslužitelj crta stranicu iznova. Bez JS-a: „Osvježi stanje”.
import ExternalLink from "@lucide/astro/icons/external-link";
import FlaskConical from "@lucide/astro/icons/flask-conical";
import Loader from "@lucide/astro/icons/loader-circle";
import RefreshCw from "@lucide/astro/icons/refresh-cw";
import type { Lang } from "../../i18n";
import QrKod from "../kampanja/QrKod.astro";
import { formatNovca } from "../kampanja/format";
import { GUMB_DRUGI, GUMB_MALI, KARTICA } from "../upravljanje/stil";
import { CHECKOUT, popuni } from "../../views/sadrzaj/checkout";
import type { MptIntent } from "../../lib/mpt/klijent";

interface Props {
  lang: Lang;
  checkoutId: string;
  cilj: "doprinos" | "napojnica";
  iznosCenti: number;
  /** Referenca iz baze (`checkouts.short_ref`) kad rail ne odgovara. */
  shortRef: string | null;
  intent: MptIntent | null;
  sandbox: boolean;
  rok: number;
  /** Stanje iz baze pri crtanju; skripta osvježava stranicu kad se promijeni. */
  stanje: string;
  /** Adresa ove stranice za „Osvježi stanje” (GET povlači stanje s raila). */
  osvjezi: string;
}
const { lang, checkoutId, cilj, iznosCenti, shortRef, intent, sandbox, rok, stanje, osvjezi } = Astro.props;
const T = CHECKOUT[lang].placanje;
const novac = formatNovca(lang);
const ref = (intent?.shortRef ?? shortRef)?.toUpperCase() ?? null;
const qrTekst = sandbox ? intent?.checkoutUrl ?? null : intent?.epcQrData ?? null;
const faza = intent?.stage ?? "awaiting_payment";
const fazaTekst = (T.faze as Record<string, string>)[faza] ?? T.faze.awaiting_payment;
const datum = new Intl.DateTimeFormat(lang === "hr" ? "hr-HR" : "en-GB", { dateStyle: "long", timeStyle: "short", timeZone: "Europe/Zagreb" }).format(intent?.expiresAt ?? rok);
const id = `placanje-${cilj}`;
const DT = "text-ink-muted";
const DD = "font-mono break-all text-ink";
---
<section aria-labelledby={id} class={`mt-6 ${KARTICA}`}>
  <h2 id={id} class="text-lg font-semibold text-ink">{popuni(T.uplatite, { iznos: novac(iznosCenti) })}</h2>
  {sandbox && (
    <p class="mt-3 flex gap-2 rounded-md border border-dashed border-warning/60 bg-warning-bg p-3 text-sm text-warning" data-sandbox>
      <FlaskConical size={18} aria-hidden="true" class="mt-0.5 shrink-0" />
      <span><strong>{T.sandbox}.</strong> {T.sandboxTekst}</span>
    </p>
  )}

  {intent || ref ? (
    <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start">
      {qrTekst && (
        <figure class="shrink-0">
          <QrKod tekst={qrTekst} naslov={T.qrNaslov} class="h-44 w-44 rounded-sm ring-1 ring-line" />
          <figcaption class="mt-1 max-w-44 text-xs text-ink-muted">{sandbox ? T.qrSandbox : T.qrBanka}</figcaption>
        </figure>
      )}
      <div class="min-w-0 flex-1">
        <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm">
          {intent?.iban && (<><dt class={DT}>{T.iban}</dt><dd class={DD}>{intent.iban}</dd></>)}
          {intent?.beneficiaryName && (<><dt class={DT}>{T.primatelj}</dt><dd class="break-words text-ink">{intent.beneficiaryName}</dd></>)}
          {ref && (<><dt class={DT}>{T.referenca}</dt><dd class={`${DD} text-base font-semibold`} data-referenca>{ref}</dd></>)}
          {intent?.memo && (<><dt class={DT}>{T.opis}</dt><dd class={DD}>{intent.memo}</dd></>)}
        </dl>
        <p class="mt-2 text-sm text-ink-soft">{T.upisiReferencu}</p>
        <p class="mt-1 text-sm text-ink-muted">{popuni(T.rok, { datum })}</p>
        {intent?.checkoutUrl && (
          <a href={intent.checkoutUrl} rel="noopener" target="_blank" class="mt-2 inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-action underline underline-offset-2">
            {T.mpt}<ExternalLink size={14} aria-hidden="true" />
          </a>
        )}
      </div>
    </div>
  ) : null}
  {!intent && <p class="mt-3 text-sm text-ink-soft">{T.nemaIntenta}</p>}

  <div class="mt-4 rounded-md bg-mist p-3">
    <h3 class="text-sm font-semibold text-ink">{T.status}</h3>
    <p
      role="status"
      class="mt-1 flex items-start gap-2 text-ink"
      data-status-uzivo
      data-cilj={cilj}
      data-stanje={stanje}
      data-events={`/api/checkouts/${encodeURIComponent(checkoutId)}/events`}
      data-stream={`/api/checkouts/${encodeURIComponent(checkoutId)}/stream?cilj=${cilj}`}
      data-faze={JSON.stringify(T.faze)}
    >
      <Loader size={18} aria-hidden="true" class="mt-0.5 shrink-0 animate-spin motion-reduce:animate-none" />
      <span data-faza>{fazaTekst}</span>
    </p>
    <a href={osvjezi} class={`mt-2 ${GUMB_MALI}`}><RefreshCw size={14} aria-hidden="true" />{T.osvjezi}</a>
  </div>

  {sandbox && (
    <div class="mt-4">
      <h3 class="text-sm font-semibold text-ink">{T.simulacija}</h3>
      <div class="mt-2 flex flex-wrap gap-2">
        {([["paid", T.simuliraj], ["underpaid", T.manja], ["rejected", T.odbijena]] as const).map(([ishod, tekst]) => (
          <form method="post" action={`/api/checkouts/${encodeURIComponent(checkoutId)}/simulate`}>
            <input type="hidden" name="ishod" value={ishod} />
            <input type="hidden" name="cilj" value={cilj} />
            <button type="submit" class={GUMB_DRUGI}>{tekst}</button>
          </form>
        ))}
      </div>
    </div>
  )}
</section>

<script>
  // Stanje uživo (S11, TODO F3). Učitavanje stranice je već povuklo stanje s raila; nakon toga jedini poziv
  // raila je SSE kroz naš Worker (`…/stream`, payload `{ state, faza }`). Pull `…/events` svake 3 s je rezerva:
  // radi dok stream ne javi prvi događaj, i opet kad stream padne ili ga rail zatvori (završna faza, 30 min).
  // Stream je samo signal: na promjenu stanja ili završnu fazu klijent zove pull, koji upisuje u bazu, pa reload.
  type Dio = { state?: string | null; faza?: string | null } | null;
  const ZAVRSNE = ["settled", "rejected", "expired"];
  for (const el of document.querySelectorAll<HTMLElement>("[data-status-uzivo]")) {
    const cilj = el.dataset.cilj === "napojnica" ? "napojnica" : "doprinos";
    const pocetno = el.dataset.stanje ?? "";
    const faze = JSON.parse(el.dataset.faze ?? "{}") as Record<string, string>;
    const tekst = el.querySelector<HTMLElement>("[data-faza]");
    let gotovo = false;
    let radi = false;
    let sat: ReturnType<typeof setInterval> | null = null;
    let izvor: EventSource | null = null;
    const prikazi = (faza: string | null | undefined) => {
      if (faza && faze[faza] && tekst) tekst.textContent = faze[faza]!;
    };
    const provjeri = async (uvijek = false) => {
      if (gotovo || radi || (!uvijek && document.hidden)) return;
      radi = true;
      try {
        const r = await fetch(el.dataset.events!, { headers: { accept: "application/json" }, cache: "no-store" });
        if (!r.ok) return;
        const j = (await r.json()) as Record<string, Dio>;
        const dio = j[cilj];
        if (!dio) return;
        prikazi(dio.faza);
        if (dio.state && dio.state !== pocetno) {
          gotovo = true;
          izvor?.close();
          location.reload();
        }
      } catch {
        /* mreža: pokušaj opet za 3 s */
      } finally {
        radi = false;
      }
    };
    const pull = () => {
      if (!sat && !gotovo) sat = setInterval(() => void provjeri(), 3000);
    };
    const bezPulla = () => {
      if (sat) clearInterval(sat);
      sat = null;
    };
    pull();
    if (typeof EventSource === "function" && el.dataset.stream) {
      izvor = new EventSource(el.dataset.stream);
      izvor.addEventListener("stanje", (e) => {
        bezPulla();
        let d: Dio = null;
        try {
          d = JSON.parse((e as MessageEvent<string>).data) as Dio;
        } catch {
          return;
        }
        prikazi(d?.faza);
        const zavrsna = !!d?.faza && ZAVRSNE.includes(d.faza);
        if (zavrsna) izvor?.close();
        if ((d?.state && d.state !== pocetno) || zavrsna) void provjeri(true);
      });
      // Pad, 404 (rail bez SSE-a) ili zatvaranje s raila: bez ponovnog spajanja, natrag na pull.
      izvor.onerror = () => {
        izvor?.close();
        pull();
      };
    }
  }
</script>
