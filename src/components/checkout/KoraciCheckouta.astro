---
// Koraci checkouta (docs/08 §3.3 `CheckoutSteps`): 1 Podaci · 2 Uplata · 3 Napojnica · 4 Potvrda.
import type { Lang } from "../../i18n";
import { CHECKOUT } from "../../views/sadrzaj/checkout";

interface Props {
  lang: Lang;
  /** Trenutni korak, 1–4. */
  korak: 1 | 2 | 3 | 4;
}
const { lang, korak } = Astro.props;
const T = CHECKOUT[lang];
---
<nav aria-label={T.korakOznaka} class="mt-3">
  <ol class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
    {T.koraci.map((naziv, i) => (
      <li class:list={["flex items-center gap-1.5", i + 1 === korak ? "font-semibold text-ink" : i + 1 < korak ? "text-ink-soft" : "text-ink-muted"]} aria-current={i + 1 === korak ? "step" : undefined}>
        <span class:list={["inline-flex size-6 items-center justify-center rounded-full text-xs", i + 1 === korak ? "bg-action text-paper" : "bg-mist text-ink-soft"]}>{i + 1}</span>
        {naziv}
      </li>
    ))}
  </ol>
</nav>
