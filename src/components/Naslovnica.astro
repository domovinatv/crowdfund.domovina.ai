---
// Naslovnica /hr i /en (S4): uvod i do 12 aktivnih kampanja iz D1. Ostatak naslovnice
// iz docs/07 (vrste kampanje, urednički izbor, brojači, kategorije) je S5.
import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import KarticaKampanje from "./KarticaKampanje.astro";
import HandHeart from "@lucide/astro/icons/hand-heart";
import { prevoditelj, type Lang } from "../i18n";
import { aktivneKampanje } from "../lib/db/kampanje";
import { url } from "../lib/rute";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = prevoditelj(lang);
const kampanje = await aktivneKampanje(env.DB, 12);
---
<Base lang={lang}>
  <section class="py-6">
    <h1 class="page-title max-w-3xl text-ink">{t("home.title")}</h1>
    <p class="mt-3 max-w-[70ch] text-lg text-ink-soft">{t("home.lead")}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={url(lang, "new-campaign")} class="inline-flex min-h-11 items-center rounded-md bg-action px-5 font-semibold text-paper hover:bg-action-strong">{t("home.cta.start")}</a>
      <a href={url(lang, "campaigns")} class="inline-flex min-h-11 items-center rounded-md px-5 font-semibold text-action ring-1 ring-action/30 hover:bg-action/10">{t("home.cta.browse")}</a>
    </div>
  </section>

  <section class="mt-8" aria-labelledby="aktivne">
    <h2 id="aktivne" class="text-2xl font-semibold">{t("home.active")}</h2>
    {
      kampanje.length === 0 ? (
        <div class="mt-4 flex flex-col items-center rounded-lg bg-mist px-6 py-12 text-center">
          <HandHeart size={32} aria-hidden="true" class="text-action" />
          <p class="mt-3 font-semibold">{t("home.empty.title")}</p>
          <p class="mt-1 text-sm text-ink-muted">{t("home.empty.body")}</p>
        </div>
      ) : (
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {kampanje.map((k) => (
            <li>
              <KarticaKampanje lang={lang} k={k} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
