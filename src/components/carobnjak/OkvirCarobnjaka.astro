---
// Okvir koraka čarobnjaka (docs/08 `WizardSteps`, §5.6): stepper s 5 koraka, napredak, izvor nacrta
// (odluka 152), jedan h1, sažetak greške. Sadržaj koraka je slot (obrazac bez JS-a).
import Check from "@lucide/astro/icons/check";
import Base from "../../layouts/Base.astro";
import type { Lang } from "../../i18n";
import { KORACI, brojKoraka } from "../../lib/db/nacrti";
import { url } from "../../lib/rute";
import { CAROBNJAK } from "../../views/sadrzaj/carobnjak";
import Greska from "../prijava/Greska.astro";
import type { PodaciKoraka } from "./ucitavanje";

interface Props {
  lang: Lang;
  podaci: PodaciKoraka;
  naslov: string;
}
const { lang, podaci, naslov } = Astro.props;
const T = CAROBNJAK[lang];
const n = brojKoraka(podaci.korak);
const imaGresaka = Object.keys(podaci.greske).length > 0;
---
<Base lang={lang} title={`${naslov} · ${T.naslov}`} noindex>
  <div class="mx-auto max-w-2xl">
    <p class="text-sm font-semibold text-ink-muted">{T.naslov} · {T.korak.replace("{n}", String(n))}</p>
    <div class="mt-2 h-2 overflow-hidden rounded-full bg-mist" aria-hidden="true">
      <div class="h-full rounded-full bg-action" style={`width: ${n * 20}%`}></div>
    </div>
    <nav aria-label={T.naslov} class="mt-3">
      <ol class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          KORACI.map((k, i) => {
            const gotov = podaci.dovrseni.includes(k);
            const trenutni = k === podaci.korak;
            return (
              <li>
                <a href={url(lang, `new-campaign.${k}`)} aria-current={trenutni ? "step" : undefined}
                  class:list={["inline-flex min-h-11 items-center gap-1 underline-offset-2 hover:underline", trenutni ? "font-semibold text-ink" : "text-ink-soft"]}>
                  {gotov ? <Check size={14} aria-hidden="true" class="text-success" /> : <span aria-hidden="true">{i + 1}.</span>}
                  {T.koraci[k]}
                </a>
              </li>
            );
          })
        }
      </ol>
    </nav>
    <p class="mt-1 text-sm text-ink-muted" data-izvor-nacrta={podaci.izvor}>{T.izvor[podaci.izvor]}</p>

    <h1 class="page-title mt-6 text-ink">{naslov}</h1>
    {imaGresaka && <Greska poruka={T.greskaObrasca} />}
    <slot />
  </div>
</Base>
