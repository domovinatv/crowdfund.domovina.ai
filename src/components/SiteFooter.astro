---
// Podnožje (docs/08 §3.1): statične stranice iz 07, impresum, jezik.
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { prevoditelj, type Lang } from "../i18n";
import { url, type KljucRute } from "../lib/rute";
import type { KljucPrijevoda } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = prevoditelj(lang);
const stupci: { naslov: KljucPrijevoda; veze: [KljucRute, KljucPrijevoda][] }[] = [
  { naslov: "footer.about", veze: [["how-it-works", "footer.howItWorks"], ["costs", "footer.costs"], ["safety", "footer.safety"], ["about", "footer.aboutUs"]] },
  { naslov: "footer.help", veze: [["faq", "footer.faq"], ["contact", "footer.contact"], ["report", "footer.report"]] },
  { naslov: "footer.legal", veze: [["terms", "footer.terms"], ["privacy", "footer.privacy"], ["ranking", "footer.ranking"]] },
];
---
<footer class="mt-12 border-t border-line bg-mist">
  <div class="mx-auto grid max-w-(--container-content) gap-8 px-4 py-10 sm:grid-cols-3 sm:px-6">
    {
      stupci.map((s) => (
        <section>
          <h2 class="text-sm font-semibold text-ink">{t(s.naslov)}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {s.veze.map(([kljuc, tekst]) => (
              <li>
                <a href={url(lang, kljuc)} class="text-ink-soft hover:text-action hover:underline">
                  {t(tekst)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <div class="mx-auto flex max-w-(--container-content) flex-col gap-3 border-t border-line px-4 py-6 text-sm text-ink-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>{t("footer.imprint")}</p>
    <LanguageSwitcher lang={lang} />
  </div>
</footer>
