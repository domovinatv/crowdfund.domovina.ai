---
// Okvir ekrana prijave i računa: osnovni raspored, uska kartica, jedan h1, noindex (docs/07).
import Base from "../../layouts/Base.astro";
import type { Lang } from "../../i18n";

interface Props {
  lang: Lang;
  naslov: string;
  uvod?: string | undefined;
}
const { lang, naslov, uvod } = Astro.props;
---
<Base lang={lang} title={naslov} noindex>
  <div class="mx-auto max-w-md">
    <h1 class="page-title text-ink">{naslov}</h1>
    {uvod && <p class="mt-2 text-ink-soft">{uvod}</p>}
    <slot />
  </div>
</Base>
