---
// Kartica organizacije u katalogu `/hr/organizacije` (pregled §8.4, funkcionalno): naziv s linkom na
// profil, oznaka verifikacije, kategorija i grad, kratki opis, broj aktivnih kampanja.
// Logotip se u prototipu ne poslužuje, pa stoji inicijal na plohi teme kategorije.
import BadgeCheck from "@lucide/astro/icons/badge-check";
import MapPin from "@lucide/astro/icons/map-pin";
import { brojem } from "./oblik";
import { prevoditelj, type Lang } from "../../i18n";
import type { KarticaOrganizacije } from "../../lib/db/profili";
import { url } from "../../lib/rute";

interface Props {
  lang: Lang;
  o: KarticaOrganizacije;
  razina?: "h2" | "h3";
}
const { lang, o, razina = "h3" } = Astro.props;
const t = prevoditelj(lang);
const Naslov = razina;
const kategorija = lang === "hr" ? o.categoryHr : o.categoryEn;
const inicijal = o.displayName.trim().charAt(0).toUpperCase();
---
<article class="flex h-full flex-col rounded-md bg-paper p-4 shadow-card">
  <div class="flex items-start gap-3">
    <span class="flex size-12 shrink-0 items-center justify-center rounded-md bg-action text-xl font-bold text-paper" aria-hidden="true">{inicijal}</span>
    <div class="min-w-0">
      <Naslov class="line-clamp-2 text-lg font-semibold leading-tight">
        <a href={url(lang, "org", { slug: o.slug })} class="hover:text-action hover:underline">{o.displayName}</a>
      </Naslov>
      {
        o.verified && (
          <p class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-success">
            <BadgeCheck size={14} aria-hidden="true" />
            {t("card.verified")}
          </p>
        )
      }
    </div>
  </div>
  <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-muted">
    {kategorija && <span class="rounded-sm bg-mist px-2 py-0.5 font-medium text-ink-soft">{kategorija}</span>}
    {
      o.city && (
        <span class="inline-flex items-center gap-1">
          <MapPin size={12} aria-hidden="true" />
          {o.city}
        </span>
      )
    }
  </p>
  {o.description && <p class="mt-3 line-clamp-3 text-sm text-ink-soft">{o.description}</p>}
  <p class="mt-auto pt-4 text-sm font-medium text-ink tabular-nums">
    {o.brojAktivnihKampanja > 0 ? brojem(lang, "count.active", o.brojAktivnihKampanja) : <span class="text-ink-muted">{t("orgCard.noActive")}</span>}
  </p>
</article>
