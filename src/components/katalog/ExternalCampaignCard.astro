---
// Kartica vanjske kampanje (docs/08 §3.2 `ExternalCampaignCard`, tok 9): kao kartica kampanje, s oznakom
// „na 4fundu” i bez našeg iznosa (iznos se vodi na vanjskoj platformi). Vodi na našu stranicu
// `/hr/vanjska/{id}`, a tek ona na vanjski URL. Slika s vanjske adrese se ne učitava (bez vanjskih resursa).
import ExternalLink from "@lucide/astro/icons/external-link";
import TemaNaslovne from "./TemaNaslovne.astro";
import { temaKategorije } from "./teme";
import { prevoditelj, type Lang } from "../../i18n";
import type { VanjskaKartica } from "../../lib/db/profili";
import { url } from "../../lib/rute";

interface Props {
  lang: Lang;
  v: VanjskaKartica;
  /** Naziv kategorije na jeziku stranice (vanjska kartica nosi samo ključ). */
  kategorija?: string | null;
  razina?: "h2" | "h3";
  /** Ime organizacije (u katalogu; na profilu organizacije se ne ponavlja). */
  organizacija?: string | null;
}
const { lang, v, kategorija = null, razina = "h3", organizacija = null } = Astro.props;
const t = prevoditelj(lang);
const Naslov = razina;
---
<article data-vanjska-kartica class="flex h-full flex-col overflow-hidden rounded-md bg-paper shadow-card">
  <TemaNaslovne tema={temaKategorije(v.categoryKey)} kategorija={v.categoryKey} class="h-24 shrink-0" />
  <div class="flex flex-1 flex-col p-4">
    <div class="flex flex-wrap items-center gap-1.5 text-xs">
      {kategorija && <span class="rounded-sm bg-mist px-2 py-0.5 font-medium text-ink-soft">{kategorija}</span>}
      <span class="inline-flex items-center gap-1 rounded-sm bg-action/10 px-2 py-0.5 font-semibold text-action">
        <ExternalLink size={12} aria-hidden="true" />
        {v.platform === "4fund" ? t("external.on4fund") : t("external.onOther")}
      </span>
    </div>
    <Naslov class="mt-2 line-clamp-2 text-lg font-semibold leading-tight">
      <a href={url(lang, "external.campaign", { id: v.id })} class="hover:text-action hover:underline">{v.title}</a>
    </Naslov>
    {organizacija && <p class="mt-1 truncate text-sm text-ink-soft">{organizacija}</p>}
    {v.description && <p class="mt-2 line-clamp-3 break-words text-sm text-ink-soft">{v.description}</p>}
    <p class="mt-auto pt-4 text-xs text-ink-muted">{t("external.noAmount")}</p>
  </div>
</article>
