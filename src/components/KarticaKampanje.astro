---
// Kartica kampanje (docs/08 §3.2), bez stanja. Link na /{lang}/{public_id}.
import Building from "@lucide/astro/icons/building";
import { LOCALE, prevoditelj, type Lang } from "../i18n";
import type { KarticaKampanje } from "../lib/db/kampanje";
import { url } from "../lib/rute";

interface Props {
  lang: Lang;
  k: KarticaKampanje;
}
const { lang, k } = Astro.props;
const t = prevoditelj(lang);
const novac = new Intl.NumberFormat(LOCALE[lang], { style: "currency", currency: k.currency, maximumFractionDigits: 0 });
const iznos = (c: number) => novac.format(c / 100);
const prikupljeno = k.raisedCents;
const postotak = prikupljeno !== null && k.goalCents ? Math.min(100, Math.round((prikupljeno / k.goalCents) * 100)) : null;
const kategorija = lang === "hr" ? k.categoryHr : k.categoryEn;
---
<article class="flex h-full flex-col rounded-md bg-paper p-4 shadow-card">
  <div class="flex items-center gap-2 text-xs text-ink-muted">
    {kategorija && <span class="rounded-sm bg-mist px-2 py-0.5 font-medium text-ink-soft">{kategorija}</span>}
    {k.demo && <span class="rounded-sm bg-warning-bg px-2 py-0.5 font-medium text-warning">{t("demo.badge")}</span>}
  </div>
  <h3 class="mt-3 text-lg font-semibold leading-tight">
    <a href={url(lang, "campaign", { id: k.publicId })} class="hover:text-action hover:underline">{k.title}</a>
  </h3>
  <p class="mt-1 flex items-center gap-1 text-sm text-ink-soft">
    <Building size={16} aria-hidden="true" />
    <span class="sr-only">{t("card.by")}:</span>
    {k.organizerName}
  </p>
  <div class="mt-auto pt-4">
    {
      prikupljeno !== null && (
        <>
          {postotak !== null && (
            <div
              class="h-2 overflow-hidden rounded-full bg-progress/15"
              role="progressbar"
              aria-label={t("card.progress")}
              aria-valuemin={0}
              aria-valuemax={100}
              aria-valuenow={postotak}
            >
              <div class="h-full rounded-full bg-progress" style={`width: ${postotak}%`} />
            </div>
          )}
          <p class="mt-2 text-sm tabular-nums">
            <strong class="text-base text-ink">{iznos(prikupljeno)}</strong> {t("card.raised")}
            {k.goalCents ? <span class="text-ink-muted"> {t("card.of")} {iznos(k.goalCents)}</span> : <span class="text-ink-muted"> · {t("card.noGoal")}</span>}
          </p>
        </>
      )
    }
    {k.contributorCount !== null && <p class="mt-1 text-xs text-ink-muted tabular-nums">{k.contributorCount} {t("card.contributors")}</p>}
  </div>
</article>
