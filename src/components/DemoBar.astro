---
// Traka prototipa (docs/08 §2.4, §3.1): uvijek na vrhu, nema pravog novca.
import FlaskConical from "@lucide/astro/icons/flask-conical";
import { prevoditelj, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const t = prevoditelj(Astro.props.lang);
---
<div class="bg-warning-bg text-warning border-b border-warning/20" role="note">
  <p class="mx-auto flex max-w-(--container-content) items-center justify-center gap-2 px-4 py-2 text-center text-sm font-medium">
    <FlaskConical size={16} aria-hidden="true" />
    <span>{t("demo.bar")}</span>
  </p>
</div>
