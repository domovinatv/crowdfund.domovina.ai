---
// Zaglavlje (docs/08 §3.1). Mobilni izbornik je <details>, radi bez JS-a.
// S6: prijavljenom (`Astro.locals.korisnik`) ime, „Moje kampanje” i odjava (POST obrazac); inače „Prijava”.
// Moderatoru (`platformRole = moderator`) i „Moderacija” na `/admin/prijave`.
import LogOut from "@lucide/astro/icons/log-out";
import Menu from "@lucide/astro/icons/menu";
import Plus from "@lucide/astro/icons/plus";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { prevoditelj, type Lang } from "../i18n";
import { jeModerator } from "../lib/pristup";
import { url } from "../lib/rute";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = prevoditelj(lang);
const veze = [
  { href: url(lang, "campaigns"), tekst: t("nav.campaigns") },
  { href: url(lang, "organisations"), tekst: t("nav.organisations") },
];
const put = Astro.url.pathname;
const korisnik = Astro.locals.korisnik ?? null;
const moderator = jeModerator(korisnik);
---
<header class="border-b border-line bg-paper">
  <div class="mx-auto flex max-w-(--container-content) items-center gap-4 px-4 py-3 sm:px-6">
    <a href={url(lang, "home")} class="group flex flex-col leading-none" aria-label={`${t("site.name")}, ${t("nav.home")}`}>
      <span class="text-lg font-bold tracking-tight text-action">{t("site.name")}</span>
      <span class="mt-1 h-0.5 w-10 bg-accent transition-all group-hover:w-full" aria-hidden="true"></span>
    </a>

    <nav aria-label={t("nav.main")} class="ml-auto hidden items-center gap-1 md:flex">
      {
        veze.map((v) => (
          <a
            href={v.href}
            aria-current={put.startsWith(v.href) ? "page" : undefined}
            class="rounded-md px-3 py-2 font-medium text-ink-soft hover:bg-mist hover:text-ink aria-[current=page]:text-action"
          >
            {v.tekst}
          </a>
        ))
      }
      <a href={url(lang, "new-campaign")} class="ml-2 inline-flex min-h-11 items-center gap-2 rounded-md bg-action px-4 font-semibold text-paper hover:bg-action-strong">
        <Plus size={18} aria-hidden="true" />
        {t("nav.start")}
      </a>
      {
        korisnik ? (
          <>
            <a href={url(lang, "my.campaigns")} class="rounded-md px-3 py-2 font-medium text-action hover:bg-action/10">{t("nav.myCampaigns")}</a>
            {moderator && <a href="/admin/prijave" class="rounded-md px-3 py-2 font-medium text-action hover:bg-action/10">{t("nav.moderation")}</a>}
            <span class="max-w-40 truncate px-2 text-sm text-ink-soft" title={korisnik.email}>
              <span class="sr-only">{t("nav.signedInAs")} </span>{korisnik.ime}
            </span>
            <form method="post" action={url(lang, "sign-out")}>
              <button type="submit" class="inline-flex min-h-11 items-center gap-1.5 rounded-md px-3 font-medium text-ink-soft hover:bg-mist hover:text-ink">
                <LogOut size={16} aria-hidden="true" />{t("nav.signOut")}
              </button>
            </form>
          </>
        ) : (
          <a href={url(lang, "sign-in")} class="rounded-md px-3 py-2 font-medium text-action hover:bg-action/10">{t("nav.signIn")}</a>
        )
      }
      <LanguageSwitcher lang={lang} class="ml-2" />
    </nav>

    <details class="relative ml-auto md:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-md hover:bg-mist [&::-webkit-details-marker]:hidden">
        <Menu size={24} aria-hidden="true" />
        <span class="sr-only">{t("nav.menu")}</span>
      </summary>
      <nav aria-label={t("nav.main")} class="absolute right-0 z-10 mt-2 flex w-64 flex-col gap-1 rounded-lg bg-paper p-2 shadow-raised">
        {veze.map((v) => <a href={v.href} class="rounded-md px-3 py-3 font-medium hover:bg-mist">{v.tekst}</a>)}
        <a href={url(lang, "new-campaign")} class="rounded-md bg-action px-3 py-3 font-semibold text-paper hover:bg-action-strong">{t("nav.start")}</a>
        {
          korisnik ? (
            <>
              <p class="truncate px-3 pt-2 text-sm text-ink-muted">{t("nav.signedInAs")} <span class="font-medium text-ink">{korisnik.ime}</span></p>
              <a href={url(lang, "my.campaigns")} class="rounded-md px-3 py-3 font-medium text-action hover:bg-action/10">{t("nav.myCampaigns")}</a>
              {moderator && <a href="/admin/prijave" class="rounded-md px-3 py-3 font-medium text-action hover:bg-action/10">{t("nav.moderation")}</a>}
              <form method="post" action={url(lang, "sign-out")}>
                <button type="submit" class="flex w-full items-center gap-2 rounded-md px-3 py-3 text-left font-medium hover:bg-mist">
                  <LogOut size={16} aria-hidden="true" />{t("nav.signOut")}
                </button>
              </form>
            </>
          ) : (
            <a href={url(lang, "sign-in")} class="rounded-md px-3 py-3 font-medium text-action hover:bg-action/10">{t("nav.signIn")}</a>
          )
        }
        <LanguageSwitcher lang={lang} class="px-1 pt-2" />
      </nav>
    </details>
  </div>
</header>
