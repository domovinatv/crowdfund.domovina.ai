---
// `/` → 302 na /hr ili /en: kolačić `lang`, pa Accept-Language, zadano hr (odluka 300).
import { odaberiJezik } from "../i18n";

const lang = odaberiJezik(Astro.cookies.get("lang")?.value, Astro.request.headers.get("accept-language"));
return new Response(null, {
  status: 302,
  headers: { Location: `/${lang}`, Vary: "Cookie, Accept-Language", "Cache-Control": "private, no-store" },
});
---
