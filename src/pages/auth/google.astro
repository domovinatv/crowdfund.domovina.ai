---
// Mock „Nastavi s Googleom” `/auth/google` (J, odluka 15): bez pravog OAuth-a. Izbor demo računa ili upis
// e-pošte; nepoznata e-pošta traži prihvat uvjeta i otvara račun. Uspjeh → `auth_identities(google,
// mock-google:{e-pošta})`, sesija, 303 na `?next=`. Jezik: iz `next`, pa kolačić `lang` i Accept-Language.
import { env } from "cloudflare:workers";
import FlaskConical from "@lucide/astro/icons/flask-conical";
import LogIn from "@lucide/astro/icons/log-in";
import Greska from "../../components/prijava/Greska.astro";
import OkvirPrijave from "../../components/prijava/OkvirPrijave.astro";
import { niz, upitNext } from "../../components/prijava/ucitavanje";
import { odaberiJezik } from "../../i18n";
import { url } from "../../lib/rute";
import {
  DEMO_RACUNI, jezikIzPuta, korisnikPoEmailu, normalizirajEmail, postaviSesiju, prijavi, sigurniNext, stvoriKorisnika, valjanEmail,
} from "../../lib/sesija";
import { PRIJAVA } from "../../views/sadrzaj/prijava";

const nextSirovo = Astro.url.searchParams.get("next");
const lang = jezikIzPuta(nextSirovo ?? "", odaberiJezik(Astro.cookies.get("lang")?.value, Astro.request.headers.get("accept-language")));
const next = nextSirovo ? sigurniNext(nextSirovo, lang) : "";
const T = PRIJAVA[lang];
let email = "";
let greska: "email_prazno" | "email_neispravan" | "obrisan" | "uvjeti" | null = null;
let nepoznata = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  email = normalizirajEmail(niz(f.get("email")));
  const sad = Date.now();
  if (!email) greska = "email_prazno";
  else if (!valjanEmail(email)) greska = "email_neispravan";
  else {
    const k = await korisnikPoEmailu(env.DB, email);
    let userId = k && !k.obrisan ? k.id : null;
    if (k?.obrisan) greska = "obrisan";
    else if (!userId && niz(f.get("uvjeti")) !== "1") {
      nepoznata = true;
      greska = niz(f.get("nepoznata")) === "1" ? "uvjeti" : null;
    } else {
      userId ??= await stvoriKorisnika(env.DB, { email, locale: lang }, sad);
      const s = await prijavi(env.DB, {
        userId, email, nacin: "google", sad,
        ip: Astro.request.headers.get("cf-connecting-ip"), userAgent: Astro.request.headers.get("user-agent"),
      });
      postaviSesiju(Astro.cookies, Astro.url, s);
      return new Response(null, { status: 303, headers: { Location: sigurniNext(next, lang), "Cache-Control": "private, no-store" } });
    }
  }
}
const G = T.google;
const polje = "mt-1.5 block w-full rounded-sm border bg-paper px-3 py-2.5 text-base text-ink";
const akcija = `/auth/google${upitNext(next)}`;
---
<OkvirPrijave lang={lang} naslov={G.naslov}>
  <p class="mt-4 flex gap-2 rounded-md border-2 border-dashed border-warning/60 bg-warning-bg p-4 text-sm text-ink">
    <FlaskConical size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-warning" />{G.mock}
  </p>
  {greska && <Greska poruka={T.greske[greska]} />}

  <h2 class="mt-8 text-lg font-semibold text-ink">{G.demoRacuni}</h2>
  <ul class="mt-3 space-y-2">
    {
      DEMO_RACUNI.map((r) => (
        <li>
          <form method="post" action={akcija}>
            <input type="hidden" name="email" value={r.email} />
            <button type="submit" class="flex min-h-11 w-full flex-col items-start rounded-md border border-ink-muted/60 px-4 py-2 text-left hover:bg-mist">
              <span class="font-medium text-ink">{G.odaberi} {r.email}</span>
              <span class="text-sm text-ink-muted">{G.uloge[r.uloga]}</span>
            </button>
          </form>
        </li>
      ))
    }
  </ul>

  <h2 class="mt-8 text-lg font-semibold text-ink">{G.ili}</h2>
  <form method="post" action={akcija} class="mt-3 space-y-4" novalidate>
    <div>
      <label for="email" class="font-semibold text-ink">{G.eposta}</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" value={email} class:list={[polje, "border-ink-muted/60"]} />
    </div>
    {
      nepoznata && (
        <label class="flex items-start gap-3">
          <input type="hidden" name="nepoznata" value="1" />
          <input type="checkbox" name="uvjeti" value="1" required class="mt-1 size-5 shrink-0 accent-action" />
          <span>
            {T.prijava.uvjetiPrije} <a href={url(lang, "terms")} class="text-action underline underline-offset-2">{T.prijava.uvjeti}</a> {T.prijava.uvjetiI}{" "}
            <a href={url(lang, "privacy")} class="text-action underline underline-offset-2">{T.prijava.privatnost}</a>
          </span>
        </label>
      )
    }
    <button type="submit" class="inline-flex min-h-11 items-center gap-2 rounded-md bg-action px-5 font-semibold text-paper hover:bg-action-strong">
      <LogIn size={18} aria-hidden="true" />{G.nastavi}
    </button>
  </form>
  <p class="mt-6 text-sm"><a href={url(lang, "sign-in") + upitNext(next)} class="font-medium text-action underline underline-offset-2">{T.prijava.naslov}</a></p>
</OkvirPrijave>
